<!doctype html>
<html lang="ja">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>optimizer の研究</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap">
<style>
/* Layout: one reading column of about 46em; figures widen to 60em. */
:root {
  --bg: #f3f5f8;
  --panel: #ffffff;
  --ink: #13171e;
  --ink-2: #4b5462;
  --ink-3: #6f7886;
  --rule: #d7dce4;
  --grid: #e6e9ee;
  --accent: #2a78d6;
  --monitor: #0d1015;
  --monitor-ink: #c9d1dc;
  --s1: #2a78d6;
  --s2: #eb6834;
  --s3: #1baf7a;
  --s4: #eda100;
  --neutral: #9aa3af;
  --good: #0a7d0a;
  --bad: #c03434;
  --warn: #9a6400;
  --good-bg: #e3f3e3;
  --bad-bg: #fbe5e5;
  --warn-bg: #fbf0d9;
  --font-display: "Zen Kaku Gothic New", "Hiragino Sans", "Noto Sans JP", sans-serif;
  --font-body: "Zen Kaku Gothic New", "Hiragino Sans", "Noto Sans JP", "Yu Gothic", sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #111418; --panel: #181c22; --ink: #e8ebef; --ink-2: #b3bac5; --ink-3: #8b94a1;
    --rule: #2b313a; --grid: #232830; --accent: #3987e5; --monitor: #07090c; --monitor-ink: #c9d1dc;
    --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --neutral: #6c7582;
    --good: #4cc24c; --bad: #ec6b6b; --warn: #e0a23a;
    --good-bg: #16301a; --bad-bg: #3a1c1c; --warn-bg: #3a2c12;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #111418; --panel: #181c22; --ink: #e8ebef; --ink-2: #b3bac5; --ink-3: #8b94a1;
  --rule: #2b313a; --grid: #232830; --accent: #3987e5; --monitor: #07090c; --monitor-ink: #c9d1dc;
  --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --neutral: #6c7582;
  --good: #4cc24c; --bad: #ec6b6b; --warn: #e0a23a;
  --good-bg: #16301a; --bad-bg: #3a1c1c; --warn-bg: #3a2c12;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body {
  background: var(--bg); color: var(--ink);
  font-family: var(--font-body); font-size: 16px; line-height: 1.85;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 0 72px;
  -webkit-font-smoothing: antialiased;
}
main { max-width: 60rem; margin: 0 auto; display: flex; flex-direction: column; gap: 64px; }
.col { max-width: 46rem; }
h1, h2, h3 { font-family: var(--font-display); text-wrap: balance; line-height: 1.35; margin: 0; }
h1 { font-weight: 900; font-size: clamp(1.9rem, 5vw, 2.8rem); letter-spacing: 0.01em; }
h2 { font-weight: 900; font-size: 1.55rem; }
h3 { font-weight: 700; font-size: 1.1rem; }
p { margin: 0; }
code, .mono { font-family: var(--font-mono); font-size: 0.88em; }
code { background: var(--grid); padding: 0.05em 0.35em; border-radius: 3px; }
.num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
section { display: flex; flex-direction: column; gap: 20px; }
.eyebrow { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.08em; color: var(--ink-3); text-transform: uppercase; }
.sec-head { display: flex; flex-direction: column; gap: 6px; border-top: 2px solid var(--ink); padding-top: 14px; }
.prose { display: flex; flex-direction: column; gap: 14px; max-width: 46rem; }
.prose ul, .prose ol { margin: 0; padding-left: 1.3em; display: flex; flex-direction: column; gap: 6px; }
.muted { color: var(--ink-2); }
.small { font-size: 0.88rem; }

header.hero { padding-top: 48px; display: flex; flex-direction: column; gap: 18px; }
.hero .lead { font-size: 1.12rem; max-width: 44rem; color: var(--ink-2); }
.meta { display: flex; flex-wrap: wrap; gap: 6px 22px; font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-3); }
.meta span b { color: var(--ink-2); font-weight: 500; }
nav.toc { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 0.9rem; }
nav.toc a { color: var(--accent); text-decoration: none; }
nav.toc a:hover, nav.toc a:focus-visible { text-decoration: underline; }

.findings { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 14px; }
.finding { background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; padding: 18px 20px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.finding .k { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-3); letter-spacing: 0.06em; }

figure { margin: 0; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
figcaption { font-size: 0.86rem; color: var(--ink-2); line-height: 1.7; max-width: 46rem; }
.fig-title { font-weight: 700; font-size: 0.95rem; }
.chart { width: 100%; overflow-x: auto; }
.chart svg { display: block; width: 100%; height: auto; overflow: visible; }
.chart text { font-family: var(--font-mono); fill: var(--ink-3); }
.legend { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 0.84rem; color: var(--ink-2); }
.legend i { display: inline-block; width: 16px; height: 3px; border-radius: 2px; vertical-align: middle; margin-right: 6px; }
.legend i.dot { width: 9px; height: 9px; border-radius: 50%; }
.duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 22px; }
.duo > * { min-width: 0; }

/* the video monitor */
.monitor { background: var(--monitor); color: var(--monitor-ink); border-radius: 8px; padding: 18px; display: flex; flex-direction: column; gap: 14px; }
.screens { display: flex; flex-wrap: wrap; gap: 18px; align-items: flex-start; }
.screen { display: flex; flex-direction: column; gap: 6px; }
.screen .lab { font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.05em; color: #8e98a6; }
.screen canvas { width: 208px; height: 208px; max-width: 100%; border: 1px solid #27303b; display: block; }
#pix { image-rendering: pixelated; }
.readout { font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.75; color: #aeb8c5; display: flex; flex-direction: column; min-width: 12rem; }
.readout b { color: #eef2f6; font-weight: 500; }
.controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.controls button { font: inherit; font-size: 0.84rem; background: #1b222b; color: #dbe2ea; border: 1px solid #343e4b; border-radius: 4px; padding: 5px 12px; cursor: pointer; }
.controls button[aria-pressed="true"] { background: #2a78d6; border-color: #2a78d6; color: #fff; }
.controls button:focus-visible, .controls input:focus-visible { outline: 2px solid #86b6ef; outline-offset: 2px; }
.controls input[type=range] { flex: 1 1 10rem; accent-color: #3987e5; }
.strip svg text { font-family: var(--font-mono); fill: #8e98a6; }

/* timeline */
ol.timeline { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; max-width: 46rem; }
ol.timeline li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 14px; padding: 12px 0; border-top: 1px solid var(--rule); }
ol.timeline li:last-child { border-bottom: 1px solid var(--rule); }
ol.timeline .when { font-family: var(--font-mono); font-size: 0.82rem; color: var(--ink-3); padding-top: 3px; }
ol.timeline .what { min-width: 0; }

/* tables */
.tablewrap { overflow-x: auto; }
table { border-collapse: collapse; font-size: 0.88rem; width: 100%; }
th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--rule); vertical-align: top; }
th { font-weight: 700; color: var(--ink-2); font-size: 0.8rem; }
td.num, th.num { text-align: right; }
.chip { display: inline-block; font-size: 0.78rem; font-weight: 700; padding: 1px 8px; border-radius: 999px; white-space: nowrap; }
.chip.ok { background: var(--good-bg); color: var(--good); }
.chip.ng { background: var(--bad-bg); color: var(--bad); }
.chip.mid { background: var(--warn-bg); color: var(--warn); }

/* status matrix */
.matrix td, .matrix th { text-align: center; }
.matrix th:first-child, .matrix td:first-child { text-align: left; }

/* dot plot */
.dots { display: flex; flex-direction: column; }
.dots .row { display: grid; grid-template-columns: minmax(7rem, 12rem) 1fr 1fr; gap: 12px; align-items: center; min-height: 30px; border-bottom: 1px solid var(--grid); }
.dots .row.head { border-bottom: 1px solid var(--rule); min-height: 0; padding-bottom: 6px; align-items: end; }
.dots .row.group { border-bottom: none; padding-top: 12px; min-height: 0; }
.dots .group span { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-3); letter-spacing: 0.06em; }
.dots .name { font-size: 0.84rem; line-height: 1.35; min-width: 0; }
.dots .track { position: relative; height: 26px; min-width: 0; }
.dots .track svg { width: 100%; height: 26px; display: block; overflow: visible; }
.dots .axis { position: relative; height: 34px; font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-3); }
.dots .axis span { position: absolute; bottom: 0; transform: translateX(-50%); white-space: nowrap; }
.dots .axis .t { bottom: 16px; font-family: var(--font-body); font-size: 0.78rem; color: var(--ink-2); font-weight: 700; transform: none; left: 0; }
.dots .fail { font-size: 0.76rem; color: var(--bad); font-weight: 700; line-height: 26px; }

.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 14px; }
.tile { background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; }
.tile .big { font-family: var(--font-mono); font-size: 1.7rem; font-weight: 500; font-variant-numeric: tabular-nums; }
.tile .sub { font-size: 0.84rem; color: var(--ink-2); }

dl.terms { display: grid; grid-template-columns: minmax(7rem, 9rem) 1fr; gap: 10px 18px; margin: 0; max-width: 46rem; }
dl.terms dt { font-family: var(--font-mono); font-size: 0.86rem; font-weight: 500; padding-top: 2px; }
dl.terms dd { margin: 0; min-width: 0; }

.diagram svg { display: block; width: 100%; height: auto; max-width: 46rem; }
.diagram text { font-family: var(--font-body); fill: var(--ink); }
.diagram .m { font-family: var(--font-mono); fill: var(--ink-3); }

#tip { position: fixed; pointer-events: none; z-index: 20; background: var(--panel); color: var(--ink); border: 1px solid var(--rule); border-radius: 4px; padding: 6px 9px; font-family: var(--font-mono); font-size: 0.74rem; line-height: 1.55; box-shadow: 0 4px 14px rgba(0,0,0,0.12); max-width: 18rem; }
pre.cmd { background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; padding: 12px 14px; overflow-x: auto; font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.7; margin: 0; }
@media (max-width: 560px) {
  ol.timeline li { grid-template-columns: 1fr; gap: 2px; }
  dl.terms { grid-template-columns: 1fr; gap: 2px 0; }
  dl.terms dd { margin-bottom: 10px; }
  .dots .row { grid-template-columns: 5.5rem 1fr 1fr; gap: 8px; }
}
@media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; } }
/* additions for exp/vision: the optimizer colors (SGD s1, momentum s2, RMSProp s3, AdamW s4) */
:root { --s4: #6250d6; --shade: rgba(42, 120, 214, 0.07); --n-in: #eef1f5; --n-enc: #e3eefb; --n-lat: #fbeedd; --n-dec: #e2f4ec; --n-out: #e2f4ec; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { --s4: #8a7cf0; --shade: rgba(57, 135, 229, 0.12); --n-in: #20252c; --n-enc: #1b2a3d; --n-lat: #3a2c18; --n-dec: #17332a; --n-out: #17332a; }
}
:root[data-theme="dark"] { --s4: #8a7cf0; --shade: rgba(57, 135, 229, 0.12); --n-in: #20252c; --n-enc: #1b2a3d; --n-lat: #3a2c18; --n-dec: #17332a; --n-out: #17332a; }
.chart text, .diagram text { fill: var(--ink-2); font-family: var(--font-mono); }
.chart text.lbl, .diagram text.lbl { fill: var(--ink-3); font-family: var(--font-body); }
.diagram text { font-family: var(--font-body); fill: var(--ink); }
.diagram text.m { font-family: var(--font-body); fill: var(--ink-3); }
.legend { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 0.8rem; color: var(--ink-2); margin-bottom: 4px; }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend svg { flex: none; }
h3.subhead { margin-top: 12px; }

/* images with row labels */
.recon { display: grid; grid-template-columns: 7.5rem 1fr; gap: 10px; align-items: stretch; }
.recon .rows { display: grid; grid-template-rows: repeat(3, 1fr); font-size: 0.78rem; color: var(--ink-2); line-height: 1.35; }
.recon .rows span { display: flex; align-items: center; border-top: 1px solid var(--rule); }
.recon .rows span:first-child { border-top: none; }
.recon img, .strip-row img { width: 100%; height: auto; display: block; border-radius: 3px; min-width: 0; }
.strips { display: flex; flex-direction: column; gap: 10px; }
.strip-row { display: grid; grid-template-columns: 7.5rem 1fr; gap: 10px; align-items: center; }
.strip-row .lab { font-size: 0.84rem; font-weight: 700; line-height: 1.4; }

/* segmented buttons and the slider */
.seg { display: flex; flex-wrap: wrap; gap: 6px; }
.seg button { font: inherit; font-size: 0.82rem; background: var(--panel); color: var(--ink-2); border: 1px solid var(--rule); border-radius: 999px; padding: 3px 12px; cursor: pointer; }
.seg button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: #fff; }
.seg button:focus-visible, .controls-row input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.controls-row { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
.controls-row input[type=range] { flex: 1 1 12rem; accent-color: var(--accent); }

/* dot plots: HTML dots on tracks */
.dots { overflow-x: auto; }
.dots .row { min-width: 34rem; }
.dots .track { position: relative; height: 26px; }
.dots .track .ref { position: absolute; top: 2px; bottom: 2px; border-left: 1px dashed var(--ink-3); }
.dots .dot { position: absolute; top: 50%; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; background: var(--c); border: 2px solid var(--c); cursor: default; }
.dots .dot.hollow { background: var(--panel); }
.dots .dot.out { border-radius: 2px; }
.dots .row > div:last-child { display: flex; align-items: center; }

details.full { max-width: 60rem; }
details.full summary { cursor: pointer; color: var(--accent); font-size: 0.92rem; }
details.full table { font-size: 0.78rem; }
details.full td, details.full th { padding: 6px 8px; white-space: nowrap; }
.prose ol { margin: 0; padding-left: 1.3em; display: flex; flex-direction: column; gap: 6px; }
@media (max-width: 560px) {
  .recon, .strip-row { grid-template-columns: 4.6rem 1fr; gap: 6px; }
  .recon .rows { font-size: 0.66rem; }
}
.chart .legend svg { width: 22px; height: 10px; display: inline-block; overflow: visible; }
.dots .track, .dots .axis { margin: 0 14px; }
@media (max-width: 560px) { .chart svg { min-width: 540px; } }
/* column rules */
th + th, td + td { border-left: 1px solid var(--rule); }
table { border-top: 1px solid var(--rule); }
.dots .track, .dots .axis { position: relative; }
.dots .track::before, .dots .axis::before { content: ""; position: absolute; left: -8px; top: -3px; bottom: -3px; border-left: 1px solid var(--rule); }
.dots .row.head .axis::before { top: -6px; bottom: -7px; }
.dots .row > div:last-child { border-left: 1px solid var(--rule); padding-left: 8px; align-self: stretch; }
.dots .row.group > span { border: none; }
.grid15 { border-collapse: separate; border-spacing: 4px; width: 100%; min-width: 34rem; }
.grid15 th { font-weight: 500; font-size: 0.82rem; color: var(--ink-2); text-align: center; background: none; border: 0; padding: 2px; }
.grid15 td { border: 1px solid var(--rule); border-radius: 6px; padding: 6px 4px; text-align: center; vertical-align: middle; line-height: 1.35; }
.grid15 td .s { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 0.98rem; font-weight: 500; }
.grid15 td .z { font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-2); display: block; }
.grid15 td .v { font-size: 0.72rem; display: block; }
.grid15 td.ok { outline: 2.5px solid var(--good); outline-offset: -2px; }
.scatter svg { width: 100%; height: auto; display: block; }
.pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
@media (max-width: 760px) { .pair { grid-template-columns: minmax(0, 1fr); } }
</style>
<body>
<main>
<header class="hero">
  <div class="eyebrow">mujou-exp · exp/vision · 2026-11-19〜20</div>
  <h1>流れ続ける動画から学ぶとき、どの optimizer を使えばよいか</h1>
  <p class="lead">街を歩きながら撮った動画を 1 枚ずつ流し、誤差逆伝播を使わない学習則 PC-ALM で VAE を学ばせました。前の資料（<a href="report.html">V0〜V10</a>）では、RMSProp なら学べて、SGD では学べないことが分かりました。この資料では、その理由を optimizer の側から調べた V11〜V15 の結果をまとめます。</p>
  <div class="meta">
    <span><b>学習則</b> PC-ALM（mujou）</span>
    <span><b>mujou</b> 3d26a3c</span>
    <span><b>run</b> V11 18 本、V12 6 本、V13 9 本、V14 35 本、V15 28 本</span>
    <span><b>計算</b> RTX 4090 × 4、バッチ 1</span>
  </div>
  <nav class="toc" aria-label="目次">
    <a href="#findings">分かったこと</a>
    <a href="#setup">実験の仕組み</a>
    <a href="#path">進め方</a>
    <a href="#v11">V11 optimizer の比較</a>
    <a href="#v12">V12 デコーダの速さ</a>
    <a href="#zuse">z を使っているか</a>
    <a href="#v13">V13 勾配の直交化</a>
    <a href="#v14">V14 幅と μP</a>
    <a href="#v15">V15 速さの格子</a>
    <a href="#drift">一歩と正味の動き</a>
    <a href="#seeds">seed による違い</a>
    <a href="#verdict">予想の判定</a>
    <a href="#next">次に</a>
    <a href="#repro">再現</a>
  </nav>
</header>

<section id="findings" aria-labelledby="h-findings">
  <div class="sec-head"><div class="eyebrow">結論</div><h2 id="h-findings">分かったこと</h2></div>
  <div class="findings">
    <article class="finding">
      <div class="k">V11・V12</div>
      <h3>学べるかどうかは、optimizer の種類では決まらない</h3>
      <p>SGD でも、デコーダの学習率だけを 100 分の 1 にすると学べました（3 つの seed で span 0.664〜0.771）。反対に、RMSProp でデコーダの学習率を 10 倍にすると、SGD と同じように学べなくなりました（span 1.681）。</p>
    </article>
    <article class="finding">
      <div class="k">V15</div>
      <h3>決め手は、デコーダの重みが 60 秒でどれだけ動くか</h3>
      <p>デコーダの重みが 60 秒で 1.4% 未満しか動かない run では、27 本のうち 26 本でデコーダが <i>z</i> を使いました。6% 以上動く run では、15 本のうち 1 本だけでした。optimizer の種類によりません。</p>
    </article>
    <article class="finding">
      <div class="k">V14</div>
      <h3>μP なら、よい学習率は幅によらない</h3>
      <p>μP では、4 つの幅のすべてで、τ = 3·10<sup>4</sup> が最もよいか、最もよいものと区別できない点でした。通常の設定（SP）では、よい τ が幅とともに 10 倍ずれました。幅を広げるほど誤差は小さくなり、最小は幅 1024 の 0.587 でした。</p>
    </article>
    <article class="finding">
      <div class="k">V13・V15</div>
      <h3>新しく試した 2 つの方法は、RMSProp を超えなかった</h3>
      <p>勾配を直交させる方法（OGD）を入れると、RMSProp と AdamW は学べなくなりました。重みの動く速さを秒で決める optimizer（Angular）は学べましたが、最もよい span は 0.802 で、RMSProp の 0.708 に届きませんでした。どちらも mujou には加えません。</p>
    </article>
  </div>
</section>

<section id="setup" aria-labelledby="h-setup">
  <div class="sec-head"><div class="eyebrow">1</div><h2 id="h-setup">実験の仕組み</h2></div>
  <div class="prose">
    <p>入力は、街を歩きながら撮った動画（Walking Tours の Amsterdam）です。動画は 1 枚ずつ流れ続け、モデルは流れてきた画像でその場で学びます。この流れをストリームと呼びます。0.1 秒ごとの 8 枚の画像（64×64 ピクセル）を 1 組にしたものを stack と呼びます。stack は 0.1 秒ごとに 1 つ届き、同じ stack が 2 度来ることはありません。1 本の run は 1800 秒（18000 stack）です。</p>
    <p>モデルは VAE で、8 つのノードに分かれています。エンコーダ（ViT-S を 4 つに分けたもの）が stack を潜在変数 <i>z</i>（256 次元）に写し、デコーダが <i>z</i> から最後の 1 枚を描き戻します。各ノードは、隣のノードと値と誤差だけをやり取りし、0.1 秒に 1 回、自分の誤差で重みを更新します。optimizer はノードごとに置き、ほかのノードの状態は見ません。</p>
  </div>
  <figure class="diagram">
    <div class="fig-title">モデルとノードの構成</div>
    <svg viewBox="0 0 760 150" role="img" aria-label="入力からエンコーダ 4 ノード、潜在、デコーダ 2 ノード、出力までの列"><g id="nodes" font-size="13"></g></svg>
    <figcaption>左から右へ値が流れ、誤差は右から左へ戻ります。V12 と V15 では、右の 3 つのノード（dec1・dec2・out。「デコーダ」と呼びます）の学習率だけを、エンコーダとは別に変えました。</figcaption>
  </figure>
  <div class="prose">
    <h3>学習率の表し方</h3>
    <p>この実験では、学習率を時定数 τ（秒）で表します。0.1 秒の更新 1 回で、重みは 0.1/τ に比例して動きます。<b>τ が大きいほど、ゆっくり学びます</b>。RMSProp と AdamW では、各重みが 1 回に動く量がほぼ 0.1/τ になります。SGD では、動く量が勾配の大きさにもよります。</p>
    <h3>指標の読み方</h3>
    <p>誤差は、どれも「どの入力にも平均の stack を出したときの誤差」を 1 とする比で表します。1 を下回れば、平均の画像を出すより良いということです。</p>
  </div>
  <dl class="terms">
    <dt><code>span</code></dt>
    <dd>学習に使った区間（0〜1800 秒）から 5 秒ごとに stack を選び、学習しているモデル（エンコーダ → <i>z</i> → デコーダ）で描き戻したときの誤差です。<b>小さいほど良い</b>。この研究の順位はこの値で決めます。</dd>
    <dt><code>after</code></dt>
    <dd>1800 秒より後の、まだ見ていない区間での同じ誤差です。</dd>
    <dt>今の誤差</dt>
    <dd>1800 秒の時点で流れていた stack の誤差です。モデルが今の場面をどれだけ描けるかを表します。</dd>
    <dt>忘却</dt>
    <dd>10〜60 秒前、60〜300 秒前、300 秒より前に流れた stack について、今の誤差から、流れたときの誤差を引いたものです。<b>小さいほど忘れていない</b>。負なら、流れたときより今のほうがよく描けます。</dd>
    <dt><code>recon_blur</code></dt>
    <dd>学習を止めたエンコーダの <i>z</i> から、別に学んだデコーダで画像を描き戻したときの誤差です（ぼかした画像どうしで比べます）。<b>小さいほど、<i>z</i> に入力の情報が残っています</b>。</dd>
    <dt><code>dyn_1/copy_1</code></dt>
    <dd><i>z</i> の 0.1 秒先を線形の式で予測したときの誤差を、「変わらない」と予測したときの誤差で割ったものです。<b>小さいほど、<i>z</i> の動きを予測しやすい</b>。</dd>
    <dt>学べた（4 条件）</dt>
    <dd>1800 秒の時点で、次の 4 つをすべて満たした run を「学べた」とします。(1) <code>span</code> が 0 秒の値より小さく、1 より小さい。(2) <code>after</code> が 0 秒の値より小さい。(3) <code>recon_blur</code> の下がり幅が、標準誤差を合わせたものの 2 倍より大きい。(4) <code>dyn_1/copy_1</code> が 0 秒の値より小さい。V8 で決めた条件です。</dd>
    <dt><i>z</i> の差</dt>
    <dd>デコーダが <i>z</i> を使っているかを調べる値です。各 stack を、その stack の <i>z</i> と、900 秒離れた別の場面の <i>z</i> の 2 通りで描き戻し、<code>span</code> の差をとります。<b>0.2 を超えれば <i>z</i> を使っている、0.05 未満なら使っていない</b>とみなします。使っていなければ、どの <i>z</i> を入れても同じ画像が出るので、差は 0 になります。</dd>
    <dt>1 フレームの一歩</dt>
    <dd>1 回の更新で、ノードの重みが自分の大きさの何割動いたか（‖Δθ‖/‖θ‖）を 300〜1800 秒で平均したものです。この資料では、その速さで 1 ラジアン回るのにかかる秒数に直して示します。</dd>
    <dt>60 秒の変位</dt>
    <dd>60 秒ごとに保存した重みを比べ、60 秒のあいだに重みが正味でどれだけ動いたか（‖θ(t+60) − θ(t)‖/‖θ(t)‖）を 300〜1800 秒で平均したものです。エンコーダ全体とデコーダ全体の、行列の重みについて求めました。</dd>
    <dt>μP</dt>
    <dd>モデルの幅を変えても、よい学習率が変わらないように、初期化と層ごとの学習率を幅に合わせて決める方法です（Tensor Programs V）。幅 256 では通常の設定（SP）と同じになります。</dd>
  </dl>
  <div class="prose">
    <p>V11〜V15 のどの段でも、順位は 4 条件を満たした run の 1800 秒の <code>span</code> で決めます。V10 では、同じ設定で seed だけを変えた 3 本の <code>span</code> が 0.708〜0.778 に散らばりました。そこで、seed 1 本どうしの比べでは、差が 0.07 より小さいものは区別しません。</p>
  </div>
</section>

<section id="path" aria-labelledby="h-path">
  <div class="sec-head"><div class="eyebrow">2</div><h2 id="h-path">進め方</h2></div>
  <div class="prose">
    <p>どの段でも、回す前に、問い・判定の基準・予想・反証の条件を README に書きました。結果はその基準で判定しています。実験を始める前に、研究の依頼者と次の範囲を決めました。更新式にステップ数を含む optimizer（Adagrad、RAdam など）は扱いません。Adam 系は AdamW だけにします。μP は幅だけで試します。mujou に加えるのは、性能の出た optimizer だけにします。</p>
  </div>
  <ol class="timeline">
    <li><div class="when">V11 · 11-19</div><div class="what"><b>optimizer の総当たり。</b>PyTorch にある基本の optimizer を 5 種類加え、それぞれ 3 つの τ で回しました。</div></li>
    <li><div class="when">V12 · 11-19</div><div class="what"><b>デコーダの速さ。</b>SGD と RMSProp で、デコーダの τ だけを 0.1〜100 倍にしました。</div></li>
    <li><div class="when">z_use · 11-20</div><div class="what"><b>デコーダが <i>z</i> を使っているかを直接測りました。</b><code>span</code> が 1 より小さいだけでは、<i>z</i> を使っているとまでは言えないためです（Codex の指摘）。</div></li>
    <li><div class="when">V13 · 11-20</div><div class="what"><b>勾配の直交化（OGD）。</b>直近の勾配と直交する向きにだけ重みを動かし、忘れにくくなるかを調べました。結果を受けて、研究の依頼者の判断で、この研究から外しました。</div></li>
    <li><div class="when">V14 · 11-19〜20</div><div class="what"><b>幅と μP。</b>幅 128〜1024 で、SP と μP のよい τ を比べました。</div></li>
    <li><div class="when">V15 · 11-20</div><div class="what"><b>エンコーダとデコーダの速さの格子。</b>重みの動く速さを秒で決める optimizer（Angular）を作り、速さそのものを変えて調べました。あわせて、学べた 2 つの設定に seed を加えました。</div></li>
  </ol>
</section>

<section id="v11" aria-labelledby="h-v11">
  <div class="sec-head"><div class="eyebrow">3 · V11</div><h2 id="h-v11">どの optimizer なら学べるか</h2></div>
  <div class="prose">
    <p><b>問い</b>　PyTorch にある基本の optimizer のうち、どれならストリームで学べるか。前の資料の見立て「重みごとに一歩の大きさをそろえると学べる」は正しいか。</p>
    <p><b>条件</b>　ViT-S から optimizer だけを変えました。seed 0、1800 秒。基準の 3 本（SGD・RMSProp・AdamW）は V8 と同じ設定です。勾配の統計も記録しましたが、学習の経過は V8 とビット単位で同じでした。</p>
  </div>
  <figure>
    <div class="fig-title">1800 秒の時点の <code>span</code> と、<i>z</i> の差（V11 の全 run）</div>
    <div class="dots" id="c-v11"></div>
    <figcaption>点 1 つが run 1 本（seed 0）です。<code>span</code> は左ほど良く、破線の 1 を下回れば平均の画像より良いことを示します。<i>z</i> の差は右にあるほど大きく、デコーダが <i>z</i> を使っています（破線は 0.2）。四角の点は、軸の外にある値です。右端は 4 条件による判定です。点に触れると値が出ます。</figcaption>
  </figure>
  <div class="prose">
    <p><b>図から読めること</b></p>
    <ul>
      <li>4 条件を満たしたのは、RMSProp τ = 10<sup>4</sup>（0.708）、RMSProp（centered）τ = 10<sup>4</sup>（0.715）、AdamW τ = 10<sup>5</sup>（0.760）の 3 本です。3 本の差は 0.07 より小さく、区別できません。</li>
      <li>Adadelta と Rprop は、どの τ でも学べませんでした。どちらも重みごとに一歩をそろえる optimizer です。Adadelta の <code>span</code>（1.671〜1.692）は、SGD（1.675）とほぼ同じでした。</li>
      <li>Muon τ = 10<sup>4</sup> の <code>span</code>（0.649）は全 run で最も小さい値でしたが、<code>dyn_1/copy_1</code> が下がらず（0.994 → 1.004）、条件 (4) で外れました。</li>
      <li>学べなかった run の多くは、<i>z</i> の差がほぼ 0 です。デコーダが <i>z</i> を使っていません。</li>
    </ul>
    <p><b>分かったこと</b>　「重みごとに一歩をそろえれば学べる」という見立ては成り立ちませんでした。回す前に決めた反証の条件（Adadelta と Rprop がどちらも学べない）に当たります。</p>
  </div>
</section>

<section id="v12" aria-labelledby="h-v12">
  <div class="sec-head"><div class="eyebrow">4 · V12</div><h2 id="h-v12">デコーダだけを遅くすると、SGD でも学べるか</h2></div>
  <div class="prose">
    <p><b>問い</b>　SGD のデコーダは、<i>z</i> を使わず、自分の重みを書き換えて今の場面を描いています（V8）。デコーダの学習率だけを下げて、重みで場面を追えないようにすると、デコーダは <i>z</i> を使い始めるか。</p>
    <p><b>条件</b>　デコーダ（dec1・dec2・out）の τ だけを <code>dec_scale</code> 倍にしました。<code>dec_scale</code> は 0.1、1、10、100 です。1 は V11 の基準の run です。seed 0、1800 秒。</p>
  </div>
  <figure>
    <div class="fig-title">デコーダの τ の倍率と、1800 秒の <code>span</code></div>
    <div class="chart" id="c-v12"></div>
    <figcaption>横軸は <code>dec_scale</code>（デコーダの τ をエンコーダの何倍にしたか。右ほどデコーダが遅い）、縦軸は 1800 秒の <code>span</code> です。塗りつぶした点は 4 条件を満たした run、白抜きの点は満たさなかった run です。SGD の 0.1 倍は 29 秒で発散したので、点がありません。</figcaption>
  </figure>
  <div class="prose">
    <p><b>図から読めること</b></p>
    <ul>
      <li>SGD は、デコーダを 100 倍遅くすると学べました（0.703）。RMSProp τ = 10<sup>4</sup>（0.708）と区別できません。10 倍では、かえって悪くなりました（1.876）。</li>
      <li>RMSProp は、デコーダを 10 倍速くすると学べなくなりました（1.681）。この値は SGD（1.675）とほぼ同じです。100 倍遅くすると、遅すぎて学べませんでした（2.790）。</li>
    </ul>
  </div>
  <figure>
    <div class="fig-title">1800 秒の時点で描き戻した画像</div>
    <div class="seg" id="seg-v12" role="group" aria-label="run を選ぶ">
      <button type="button" data-key="sgd" aria-pressed="true">SGD τ=10<sup>5</sup></button>
      <button type="button" data-key="sgd_dec100" aria-pressed="false">SGD、デコーダ 100 倍遅く</button>
      <button type="button" data-key="rms" aria-pressed="false">RMSProp τ=10<sup>4</sup></button>
    </div>
    <div class="recon" id="r-v12" data-img="sgd" data-rows="本物（最後の 1 枚）|学習しているモデル|後から学んだデコーダ"></div>
    <figcaption>学習区間から等間隔に選んだ 10 個の stack です。1 段目が本物、2 段目が学習しているモデルの出力、3 段目が止めた <i>z</i> から後で学んだデコーダの出力です。SGD の 2 段目は、どの stack にも同じ画像を出しています。デコーダを遅くした SGD と RMSProp では、2 段目が入力によって少しずつ変わります。</figcaption>
  </figure>
  <div class="prose">
    <p><b>分かったこと</b>　学べるかどうかは、optimizer の種類より、デコーダの重みがどれだけ速く動くかで決まっています。デコーダが速いと、デコーダは今の場面を自分の重みで覚え、<i>z</i> を使いません。</p>
  </div>
</section>

<section id="zuse" aria-labelledby="h-zuse">
  <div class="sec-head"><div class="eyebrow">5 · z_use</div><h2 id="h-zuse">デコーダは <i>z</i> を使っているか</h2></div>
  <div class="prose">
    <p><b>問い</b>　<code>span</code> が 1 を下回っても、デコーダが <i>z</i> を使っているとは限りません。今の場面を重みで覚えるだけでも、平均の画像よりは良く描けるからです。そこで、<i>z</i> を入れ替えて、デコーダが <i>z</i> を使っているかを直接調べました。</p>
    <p><b>条件</b>　V11 と V12 の 1800 秒のモデルです。各 stack を、正しい <i>z</i>、900 秒離れた stack の <i>z</i>、全 stack の <i>z</i> の平均の 3 通りで描き戻しました。</p>
  </div>
  <figure>
    <div class="fig-title">正しい <i>z</i> と、900 秒離れた <i>z</i> で描き戻したときの誤差</div>
    <div class="dots" id="c-zuse"></div>
    <figcaption>点 1 つが run 1 本です。<i>z</i> の差（右の列）が大きい順に並べました。デコーダが <i>z</i> を使っていなければ、左の 2 列の点は同じ位置に来ます。</figcaption>
  </figure>
  <div class="prose">
    <p><b>図から読めること</b></p>
    <ul>
      <li>学べなかった SGD 系の run（SGD、Nesterov τ = 10<sup>5</sup>、Adadelta、RMSProp（centered）τ = 10<sup>3</sup>、デコーダを速くした RMSProp）では、<i>z</i> を入れ替えても誤差が ±0.003 しか変わりません。デコーダは <i>z</i> をまったく使っていません。</li>
      <li><code>span</code> が 1 を下回った 6 本と Muon τ = 10<sup>4</sup> では、<i>z</i> を入れ替えると誤差が 0.69〜0.86 増えます。デコーダは <i>z</i> を使っています。</li>
      <li>Rprop τ = 10<sup>4</sup>・10<sup>5</sup>、Muon τ = 10<sup>3</sup>、デコーダを 100 倍遅くした RMSProp は、<i>z</i> を使い始めています（+0.25〜+0.60）が、<code>span</code> は 1 を下回りません。学ぶのが遅いためです。</li>
    </ul>
  </div>
</section>

<section id="v13" aria-labelledby="h-v13">
  <div class="sec-head"><div class="eyebrow">6 · V13</div><h2 id="h-v13">勾配を直交させると、忘れにくくなるか</h2></div>
  <div class="prose">
    <p><b>問い</b>　直近に保存した勾配と直交する向きにだけ重みを動かすと（OGD）、忘れにくくなり、<code>span</code> は小さくなるか。</p>
    <p><b>条件</b>　V11 の基準の 3 本に OGD を加えました。直近 16 本の勾配を、<i>s</i> 秒ごと（<i>s</i> = 0.1、1、10）に保存します。seed 0、1800 秒。</p>
  </div>
  <figure>
    <div class="fig-title">OGD の有無と、<code>span</code>・今の誤差・10〜60 秒の忘却</div>
    <div class="dots" id="c-v13"></div>
    <figcaption>点 1 つが run 1 本です。「OGD なし」は V11 の基準の run です。<code>span</code> と今の誤差は左ほど良く、破線は 1 です。忘却も左ほど良い値です。</figcaption>
  </figure>
  <div class="prose">
    <p><b>図から読めること</b></p>
    <ul>
      <li>OGD を入れると、RMSProp と AdamW は学べなくなりました（<code>span</code> 3.0〜4.9）。今の場面の誤差も 4〜7 に残り、1800 秒かけても平均の画像より悪いままです。</li>
      <li>ストリームでは、直近の勾配こそが今下るべき向きです。OGD はこの向きを取り除くので、重みがほとんど動かなくなります。</li>
      <li>RMSProp の 10〜60 秒の忘却は、0.28 から 0.14〜0.18 に下がりました。ただし、ほとんど何も学んでいないので、忘れにくくなったとは言えません。</li>
    </ul>
    <p><b>分かったこと</b>　OGD は効果がありませんでした。ストリームには「タスク」の区切りがなく、勾配の相関も 10 秒でほぼ消えるので、研究の依頼者の判断で、OGD はこの研究から外しました。</p>
  </div>
</section>

<section id="v14" aria-labelledby="h-v14">
  <div class="sec-head"><div class="eyebrow">7 · V14</div><h2 id="h-v14">モデルの幅を変えると、よい学習率は変わるか</h2></div>
  <div class="prose">
    <p><b>問い</b>　モデルの幅を変えると、よい τ は変わるか。μP にすると、幅によらず同じ τ がよくなるか。</p>
    <p><b>条件</b>　RMSProp で、幅 128・256・512・1024、τ = 10<sup>3</sup>〜10<sup>5</sup> の 5 点を、SP と μP で回しました（幅 256 は SP と μP が同じ）。35 本、seed 0、1800 秒。</p>
  </div>
  <div class="pair">
    <figure>
      <div class="fig-title">SP（通常の設定）</div>
      <div class="chart" id="c-v14-sp"></div>
    </figure>
    <figure>
      <div class="fig-title">μP</div>
      <div class="chart" id="c-v14-mup"></div>
    </figure>
  </div>
  <div class="prose small muted">
    <p>横軸は τ（右ほどゆっくり学ぶ）、縦軸は 1800 秒の <code>span</code>（下ほど良い）です。線の色が幅です。塗りつぶした点は 4 条件を満たした run、白抜きの点は満たさなかった run です。</p>
  </div>
  <div class="tablewrap">
    <table>
      <thead><tr><th></th><th class="num">幅 128</th><th class="num">幅 256</th><th class="num">幅 512</th><th class="num">幅 1024</th></tr></thead>
      <tbody id="t-v14"></tbody>
    </table>
  </div>
  <div class="prose small muted"><p>各幅の最もよい τ（4 条件を満たし、<code>span</code> が最小のもの）と、その <code>span</code> です。括弧内は、最もよいものと 0.07 以内で区別できない τ です。</p></div>
  <div class="prose">
    <p><b>図と表から読めること</b></p>
    <ul>
      <li>μP では、最もよい τ が 4 つの幅すべてで 3·10<sup>4</sup> か、その隣の 10<sup>5</sup> でした。幅 1024 でも、3·10<sup>4</sup>（0.633）は最もよい 10<sup>5</sup>（0.587）と区別できません。</li>
      <li>SP では、最もよい τ が幅 128 の 10<sup>4</sup> から幅 1024 の 10<sup>5</sup> まで、10 倍ずれました。同じ τ = 10<sup>4</sup> でも、SP は幅 512・1024 で学べませんでしたが（1.217、1.587）、μP は学べました（0.715、0.917）。</li>
      <li>幅を広げるほど <code>span</code> は小さくなりました。最小は幅 1024 の μP、τ = 10<sup>5</sup> の 0.587 で、V11〜V15 の全 run で最も小さい値です。</li>
      <li>幅 256（ViT-S）では、τ = 3·10<sup>4</sup> の 0.635 が、これまでの基準の τ = 10<sup>4</sup>（0.708）より小さくなりました。差は 0.073 で、区別の目安の 0.07 をわずかに超えるだけです（seed 1 本）。</li>
      <li>τ = 10<sup>5</sup> は、幅 1024 を除いて条件 (4) で外れました。τ ≤ 3·10<sup>3</sup> では、どの幅でもデコーダが <i>z</i> を使いません。</li>
    </ul>
    <p><b>分かったこと</b>　μP にすれば、よい学習率を幅 256 で決めて、ほかの幅にも使えます（muTransfer）。seed は 1 本なので、まだ確かめきれていません。</p>
  </div>
</section>

<section id="v15" aria-labelledby="h-v15">
  <div class="sec-head"><div class="eyebrow">8 · V15</div><h2 id="h-v15">エンコーダとデコーダの速さを直接決めると</h2></div>
  <div class="prose">
    <p><b>問い</b>　V12 では、デコーダの速さを optimizer ごとに観測しただけでした。速さそのものを設定にして変えると、デコーダが <i>z</i> を使うかは、デコーダの速さだけで決まるか。学べるのは、どの速さの組み合わせか。</p>
    <p><b>道具</b>　Angular という optimizer を作りました。行列の重みは、勾配の移動平均（時定数 1 秒）の向きに、自分の大きさの 0.1/τ だけ動きます。動く割合が勾配の大きさによらず決まるので、τ は「行列が約 1 ラジアン回るのにかかる秒数」になります。行列でない重み（バイアスなど）は RMSProp で動かします。</p>
    <p><b>条件</b>　エンコーダの τ（<i>T</i><sub>enc</sub>）を 100・300・1000・3000 秒、デコーダの τ（<i>T</i><sub>dec</sub>）を 30〜10000 秒の 6 点にしました。24 本、seed 0、1800 秒。</p>
  </div>
  <figure>
    <div class="fig-title">速さの格子: 1800 秒の <code>span</code>、<i>z</i> の差、判定</div>
    <div class="tablewrap"><table class="grid15" id="t-v15"></table></div>
    <figcaption>行がエンコーダの τ、列がデコーダの τ（どちらも秒。右・下ほど遅い）です。各セルの大きな数字が <code>span</code>、その下が <i>z</i> の差、最後が判定です。緑の枠は 4 条件を満たした点です。セルの色は <i>z</i> の差で、濃いほどデコーダが <i>z</i> を使っています。</figcaption>
  </figure>
  <div class="prose">
    <p><b>図から読めること</b></p>
    <ul>
      <li>デコーダの τ が 100 秒以下の 8 点では、デコーダは <i>z</i> をほぼ使いません。例外は、エンコーダが最も遅い 3000 秒・100 秒の点（+0.225）だけです。</li>
      <li>デコーダの τ が 300 秒の列では、エンコーダが速い（100・300 秒）と <i>z</i> を使わず、遅い（1000・3000 秒）と使います。デコーダの速さだけでは決まりません。</li>
      <li>4 条件を満たしたのは 6 点です。外れ方は 3 通りあります。デコーダが速すぎる（<i>z</i> を使わない）、エンコーダが遅すぎる（3000 秒の行。条件 (4) で外れる）、デコーダが遅すぎる（10000 秒の列。<code>span</code> が 1 を下回らない）です。</li>
      <li>4 条件を満たした点で最も小さい <code>span</code> は、1000 秒・1000 秒の 0.802 です。RMSProp τ = 10<sup>4</sup>（0.708）より 0.094 大きく、Angular は RMSProp を超えませんでした。</li>
    </ul>
  </div>
</section>

<section id="drift" aria-labelledby="h-drift">
  <div class="sec-head"><div class="eyebrow">9 · V11・V12・V15</div><h2 id="h-drift">速さは「1 フレームの一歩」ではなく「60 秒の変位」で測る</h2></div>
  <div class="prose">
    <p><b>問い</b>　V12 では、1 フレームの一歩から求めたデコーダの速さで、<i>z</i> を使うかどうかが分かれるように見えました。V15 の格子でも、同じ測り方で分かれるか。</p>
    <p><b>条件</b>　V11・V12・V15 の、完走した 49 本です（V15 の seed の 4 本を含みます）。左の図は 1 フレームの一歩から求めた dec2 の速さ、右の図はデコーダ全体の 60 秒の変位を横軸にしました。</p>
  </div>
  <div class="pair">
    <figure>
      <div class="fig-title">1 フレームの一歩から求めた速さ</div>
      <div class="chart scatter" id="c-step"></div>
    </figure>
    <figure>
      <div class="fig-title">60 秒の変位</div>
      <div class="chart scatter" id="c-drift"></div>
    </figure>
  </div>
  <div class="prose small muted">
    <p>点 1 つが run 1 本です。縦軸は <i>z</i> の差で、上ほどデコーダが <i>z</i> を使っています（破線は 0.2 と 0.05）。左の横軸は dec2 が 1 ラジアン回るのにかかる秒数（右ほど遅い）、右の横軸はデコーダの重みが 60 秒で動いた割合（%、左ほど遅い）で、どちらも対数です。色は optimizer の種類です。本文で比べる 2 本の点には、図の中に名前を書き添えました。点に触れると値が出ます。</p>
  </div>
  <div class="prose">
    <p><b>図から読めること</b></p>
    <ul>
      <li>左の図では、Angular（<i>T</i><sub>enc</sub> = <i>T</i><sub>dec</sub> = 300 秒）と RMSProp τ = 10<sup>4</sup> の速さがほぼ同じ（576 秒と 603 秒）なのに、Angular のデコーダは <i>z</i> を使わず（−0.002）、RMSProp のデコーダは使っています（+0.724）。1 フレームの一歩では、optimizer をまたいで比べられません。</li>
      <li>右の図では、同じ 2 本が離れます。60 秒の変位は、Angular が 4.1%、RMSProp が 1.3% です。</li>
      <li>右の図で、デコーダの 60 秒の変位が 1.4% 未満の 27 本のうち 26 本が <i>z</i> を使いました（例外の Muon τ = 10<sup>5</sup> は、遅すぎて何も学べていません）。6% 以上の 15 本では、<i>z</i> を使ったのは 1 本（+0.225）だけでした。2〜5% の 7 本では、エンコーダが遅い run ほど <i>z</i> を使いました。</li>
    </ul>
    <p><b>なぜ違うのか</b>　Angular は勾配の移動平均の向きに進むので、続くフレームの一歩がほぼ同じ向きに積み重なります。RMSProp は生の勾配の向きに進みます。隠れ層の勾配はフレームごとにほぼ無相関なので、一歩どうしが打ち消し合います。そのため、1 フレームの一歩が同じでも、60 秒で正味に動く量は Angular のほうが約 3 倍大きくなります。</p>
  </div>
  <figure>
    <div class="fig-title">1 フレームの一歩から求めた速さが同じ 2 本の、描き戻した画像（1800 秒）</div>
    <div class="seg" id="seg-drift" role="group" aria-label="run を選ぶ">
      <button type="button" data-key="ang_300_300" aria-pressed="true">Angular 300 秒・300 秒</button>
      <button type="button" data-key="rms" aria-pressed="false">RMSProp τ=10<sup>4</sup></button>
      <button type="button" data-key="ang_1000_1000" aria-pressed="false">Angular 1000 秒・1000 秒</button>
    </div>
    <div class="recon" id="r-drift" data-img="ang_300_300" data-rows="本物（最後の 1 枚）|学習しているモデル|後から学んだデコーダ"></div>
    <figcaption>並びは V12 の画像と同じです。Angular 300 秒・300 秒の 2 段目は、どの stack にも同じ運河の画像を出しています。1800 秒の直前に流れていた場面を、重みで覚えているとみられます。デコーダを遅くした Angular 1000 秒・1000 秒では、2 段目が入力によって変わります。</figcaption>
  </figure>
  <div class="prose">
    <p><b>分かったこと</b>　デコーダが <i>z</i> を使うかどうかは、optimizer の種類によらず、場面が変わる時間（数十秒）のあいだにデコーダの重みが正味でどれだけ動くかで、ほぼ決まります。60 秒で 1% 程度まで遅ければ使い、6% 以上動けば使いません。その間では、エンコーダの速さも影響します。</p>
  </div>
</section>

<section id="seeds" aria-labelledby="h-seeds">
  <div class="sec-head"><div class="eyebrow">10 · V15</div><h2 id="h-seeds">seed を変えても同じ結果になるか</h2></div>
  <div class="prose">
    <p><b>問い</b>　デコーダを 100 倍遅くした SGD（学べた）と Muon τ = 10<sup>4</sup>（<code>span</code> は最小だが条件 (4) で外れた）は、seed を変えても同じ結果になるか。</p>
    <p><b>条件</b>　それぞれ seed 1・2 を加えました。RMSProp τ = 10<sup>4</sup> の 3 つの seed（V8）と並べます。</p>
  </div>
  <figure>
    <div class="fig-title">seed ごとの <code>span</code> と <code>dyn_1/copy_1</code>（1800 秒）</div>
    <div class="dots" id="c-seeds"></div>
    <figcaption>点 1 つが run 1 本です。<code>span</code> は左ほど良い値です。<code>dyn_1/copy_1</code> は、0 秒の値（約 0.99、破線）より左に来れば条件 (4) を満たします。</figcaption>
  </figure>
  <div class="prose">
    <p><b>図から読めること</b></p>
    <ul>
      <li>デコーダを 100 倍遅くした SGD は、3 つの seed すべてで学べました（平均 0.713）。RMSProp τ = 10<sup>4</sup> の 3 つの seed の平均（0.741）と区別できません。</li>
      <li>Muon τ = 10<sup>4</sup> は、3 つの seed すべてで <code>span</code> が小さい（0.649〜0.701）一方、<code>dyn_1/copy_1</code> が下がりませんでした（1.004〜1.009）。</li>
    </ul>
  </div>
</section>

<section id="verdict" aria-labelledby="h-verdict">
  <div class="sec-head"><div class="eyebrow">11</div><h2 id="h-verdict">予想の判定</h2></div>
  <div class="prose">
    <p>回す前に README に書いた予想と、その判定です。判定の基準（4 条件、<i>z</i> の差の 0.2 と 0.05、区別の目安の 0.07）も、回す前に決めました。</p>
  </div>
  <div class="tablewrap">
    <table>
      <thead><tr><th>段</th><th>回す前の予想</th><th>判定</th><th>根拠</th></tr></thead>
      <tbody>
        <tr><td class="mono">V11</td><td>Nesterov は、どの τ でも <code>span</code> が 1 を下回らない</td><td><span class="chip ok">当たり</span></td><td class="small">10<sup>4</sup> は発散、10<sup>5</sup>・10<sup>6</sup> は 1.638・1.547</td></tr>
        <tr><td class="mono">V11</td><td>RMSProp（centered）τ = 10<sup>4</sup> は学べ、RMSProp と区別できない</td><td><span class="chip ok">当たり</span></td><td class="small">0.715 と 0.708</td></tr>
        <tr><td class="mono">V11</td><td>Adadelta と Rprop は、少なくとも 1 つの τ で学べる</td><td><span class="chip ng">外れ</span></td><td class="small">どの τ でも学べない。反証の条件に当たり、「重みごとに一歩をそろえるだけでは足りない」とした</td></tr>
        <tr><td class="mono">V11</td><td>Muon は学べる</td><td><span class="chip ng">外れ</span></td><td class="small">10<sup>4</sup> の <code>span</code> は最小（0.649）だが条件 (4) で外れた。3 seed とも同じ</td></tr>
        <tr><td class="mono">V12</td><td>SGD のデコーダを 100 倍遅くすると、<code>span</code> が 1 を下回る</td><td><span class="chip ok">当たり</span></td><td class="small">0.703。<i>z</i> の差 +0.802 で、<i>z</i> を使っている</td></tr>
        <tr><td class="mono">V12</td><td>RMSProp のデコーダを 10 倍遅くすると、学べるが <code>span</code> は大きくなる</td><td><span class="chip mid">一部</span></td><td class="small">学べたが、差（0.024）は区別できない</td></tr>
        <tr><td class="mono">V12</td><td>デコーダを 10 倍速くすると悪くなる（SGD は発散もありうる）</td><td><span class="chip ok">当たり</span></td><td class="small">SGD は 29 秒で発散、RMSProp は 1.681</td></tr>
        <tr><td class="mono">V13</td><td>RMSProp・AdamW に OGD を入れても、<code>span</code> は OGD なしと区別できない（<i>s</i> = 1・10）</td><td><span class="chip ng">外れ</span></td><td class="small">どの <i>s</i> でも学べない（2.99〜4.86）。OGD は加えない</td></tr>
        <tr><td class="mono">V13</td><td>SGD は、どの <i>s</i> でも <code>span</code> が 1 を下回らない</td><td><span class="chip ok">当たり</span></td><td class="small">1.491〜1.689</td></tr>
        <tr><td class="mono">V14</td><td>SP では、幅が広いほどよい τ が大きい</td><td><span class="chip ok">当たり</span></td><td class="small">幅 128 の 10<sup>4</sup> から幅 1024 の 10<sup>5</sup> へ</td></tr>
        <tr><td class="mono">V14</td><td>SP の幅 1024 では τ = 10<sup>3</sup> が発散する</td><td><span class="chip ng">外れ</span></td><td class="small">発散せず、<code>span</code> 1.639</td></tr>
        <tr><td class="mono">V14</td><td>μP では、よい τ が幅によらず同じ点か隣の点にある</td><td><span class="chip ok">当たり</span></td><td class="small">3·10<sup>4</sup> か 10<sup>5</sup></td></tr>
        <tr><td class="mono">V15</td><td>デコーダの τ が 100 秒以下の 8 本は <i>z</i> を使わない</td><td><span class="chip mid">一部</span></td><td class="small">7 本は当たり。3000 秒・100 秒の点が +0.225 で、反証の条件に当たった。デコーダの速さだけでは決まらない</td></tr>
        <tr><td class="mono">V15</td><td>デコーダの τ が 1000 秒以上、エンコーダの τ が 1000 秒以下の 9 本は <i>z</i> を使う</td><td><span class="chip ok">当たり</span></td><td class="small">+0.51〜+0.80</td></tr>
        <tr><td class="mono">V15</td><td>エンコーダの τ が 3000 秒でも学べる</td><td><span class="chip ng">外れ</span></td><td class="small">6 点とも学べない。4 点は条件 (4) で外れた</td></tr>
        <tr><td class="mono">V15</td><td>Angular の最小の <code>span</code> は、RMSProp と区別できない</td><td><span class="chip ng">外れ</span></td><td class="small">4 条件を満たす点の最小は 0.802 で、RMSProp（0.708）より悪い</td></tr>
      </tbody>
    </table>
  </div>
</section>

<section id="next" aria-labelledby="h-next">
  <div class="sec-head"><div class="eyebrow">12</div><h2 id="h-next">次の実験で使うものと、残る課題</h2></div>
  <div class="prose">
    <p><b>次の実験で使うもの</b>　optimizer は RMSProp のままにします。幅を変えるときは μP を使い、τ は幅 256 で決めます。評価には、4 条件に加えて <i>z</i> の差と 60 秒の変位を記録します。</p>
    <p><b>まだ分からないこと</b></p>
    <ul>
      <li><b>ViT-S の τ を 3·10<sup>4</sup> に変えるべきか。</b>差は 0.073 で、seed 1 本の比べです。seed を加えて確かめます。</li>
      <li><b>デコーダの 60 秒の変位を、直接決められるか。</b>決め手が分かったので、それを設定にする optimizer が考えられます。Angular は 1 フレームの一歩を決めたため、正味の動きは決められませんでした。</li>
      <li><b>原因と結果の区別。</b>60 秒の変位は、300〜1800 秒で測った量です。デコーダが <i>z</i> を使うかは、最初の数十秒で決まっているのかもしれません。<i>z</i> を使わないデコーダは今の場面を重みで追うので、重みがよく動く、という逆向きの関係もありえます。V15 では速さを設定で変えたので、その範囲では速さが原因と言えます。</li>
      <li><b>エンコーダが遅いと、なぜ条件 (4) で外れるのか。</b>エンコーダの 60 秒の変位が約 0.5% 以下の run で、<code>dyn_1/copy_1</code> が下がりませんでした。</li>
    </ul>
  </div>
</section>

<section id="repro" aria-labelledby="h-repro">
  <div class="sec-head"><div class="eyebrow">付録</div><h2 id="h-repro">再現</h2></div>
  <div class="prose">
    <p>mujou は <code>3d26a3c</code> です。判定の基準・予想・数値の詳細は <a href="README.md">README.md</a> の V11〜V15 にあります。run の結果とチェックポイントは <code>runs/&lt;batch&gt;/</code> にあり、git には入れていません。この資料は <code>python -m exp.vision.report.build_optim</code> で作りました。</p>
  </div>
  <div class="tablewrap">
    <table>
      <thead><tr><th>段</th><th>batch</th><th>snapshot</th></tr></thead>
      <tbody>
        <tr><td>V11</td><td><code>v11-zoo</code></td><td class="num">6ecef901c9dc</td></tr>
        <tr><td>V12</td><td><code>v12-dec</code></td><td class="num">6ecef901c9dc</td></tr>
        <tr><td>V13</td><td><code>v13-ogd</code></td><td class="num">9208b67e7c51</td></tr>
        <tr><td>V14</td><td><code>v14-width</code></td><td class="num">6ecef901c9dc</td></tr>
        <tr><td>V15</td><td><code>v15-speed</code>、<code>v15-seeds</code></td><td class="num">50bcf201597f</td></tr>
        <tr><td>基準</td><td><code>v8-adapt</code>、<code>v8-rms</code>（RMSProp τ = 10<sup>4</sup> の 3 seed）</td><td class="num">2ee162ca33aa</td></tr>
      </tbody>
    </table>
  </div>
<pre class="cmd"># run（std-00〜03 に投入）。例: V15 の 1 点
just fleet submit --batch v15-speed +experiment=v0/base optim=angular optim.tau=300 optim.dec_scale=3.333 measure.ckpt_every=60 measure.grad_stats=true --seeds 0
# 学習のストリームでの評価と、z の差
python -m exp.vision.stream_eval &lt;run_dir&gt;
python -m exp.vision.z_use &lt;run_dir&gt;
# 60 秒の変位（チェックポイントのある NAS の上で）
python -m exp.vision.drift &lt;run_dir&gt; ... &gt; runs/optim-drift.jsonl
# 判定の表と、この資料
uv run python -m exp.vision.tables --stream runs/v15-speed
uv run python -m exp.vision.report.build_optim --drift runs/optim-drift.jsonl</pre>
  <div class="prose">
    <p class="small muted">この資料のために計算した値: 1 フレームの一歩から求めた速さは、<code>grad.jsonl</code> の dec2 の ‖Δθ‖/‖θ‖ を 300 秒以降で平均し、0.1 秒をその値で割ったものです。60 秒の変位は <code>exp/vision/drift.py</code> で求めました。V15 の seed の平均は、各 seed の 1800 秒の <code>span</code> の単純平均です。</p>
  </div>
</section>
</main>
<div id="tip" hidden></div>
<script type="application/json" id="data">/*__DATA__*/</script>
<script>
(() => {
const D = JSON.parse(document.getElementById('data').textContent);
const NS = 'http://www.w3.org/2000/svg';
const tip = document.getElementById('tip');
function showTip(ev, html) {
  tip.innerHTML = html; tip.hidden = false;
  const w = tip.offsetWidth, h = tip.offsetHeight;
  let x = ev.clientX + 14, y = ev.clientY + 14;
  if (x + w > innerWidth - 8) x = ev.clientX - w - 14;
  if (y + h > innerHeight - 8) y = ev.clientY - h - 14;
  tip.style.left = Math.max(8, x) + 'px'; tip.style.top = Math.max(8, y) + 'px';
}
const hideTip = () => { tip.hidden = true; };
function el(tag, attrs, parent) {
  const e = document.createElementNS(NS, tag);
  for (const k in attrs) {
    const v = attrs[k];
    if ((k === 'fill' || k === 'stroke') && typeof v === 'string' && v.startsWith('var(')) e.style[k] = v;
    else e.setAttribute(k, v);
  }
  if (parent) parent.appendChild(e);
  return e;
}
const fmt = (v, d = 3) => v == null ? '—' : (+v).toFixed(d);
const sup = s => s.replace(/1e(\d)/g, (_, k) => '10<sup>' + k + '</sup>');

function legend(host, items) {
  const lg = document.createElement('div'); lg.className = 'legend';
  for (const it of items) {
    const s = document.createElement('span');
    const dash = it.dash ? `stroke-dasharray="${it.dash}"` : '';
    s.innerHTML = `<svg width="22" height="10" aria-hidden="true"><line x1="1" x2="21" y1="5" y2="5" style="stroke:${it.color}" stroke-width="${it.width || 2.5}" ${dash}/></svg>${it.label}`;
    lg.appendChild(s);
  }
  host.appendChild(lg);
}

// A line chart. o: {series: [{label, color, xs, ys, width, dash, opacity, marker}],
// xmin, xmax, ymin, ymax, log (y), symlog (x, linthresh), xticks, yticks, xfmt, yfmt,
// xlabel, ylabel, refs: [{y, label}], vlines: [{x, label}], shade: [x0, x1, label],
// nearest (tooltip on the series nearest the pointer), legend: [{label, color, dash}]}
let clipN = 0;
function lineChart(host, o) {
  host.innerHTML = '';
  if (o.legend) legend(host, o.legend);
  const W = o.width || 720, H = o.height || 270, m = {l: 50, r: 30, t: 24, b: 38};
  const svg = el('svg', {viewBox: `0 0 ${W} ${H}`, role: 'img', 'aria-label': o.aria || ''});
  host.appendChild(svg);
  const iw = W - m.l - m.r, ih = H - m.t - m.b;
  const ty = v => o.log ? Math.log10(v) : v;
  const lt = o.symlog || 10;
  const tx = x => o.symlog ? Math.sign(x) * Math.log10(1 + Math.abs(x) / lt) : x;
  const y0 = ty(o.ymin), y1 = ty(o.ymax), x0 = tx(o.xmin), x1 = tx(o.xmax);
  const X = x => m.l + (tx(x) - x0) / (x1 - x0) * iw;
  const Y = v => m.t + ih - (Math.min(Math.max(ty(v), y0), y1) - y0) / (y1 - y0) * ih;
  const g = el('g', {}, svg);
  if (o.shade) {
    el('rect', {x: X(o.shade[0]), width: Math.max(0, X(o.shade[1]) - X(o.shade[0])), y: m.t, height: ih, fill: 'var(--shade)'}, g);
    if (o.shade[2]) { const t = el('text', {x: X(o.shade[0]) + 6, y: m.t + 14, 'font-size': 11, class: 'lbl'}, g); t.textContent = o.shade[2]; }
  }
  for (const t of o.yticks) {
    el('line', {x1: m.l, x2: W - m.r, y1: Y(t), y2: Y(t), stroke: 'var(--grid)', 'stroke-width': 1}, g);
    const e = el('text', {x: m.l - 8, y: Y(t) + 4, 'text-anchor': 'end', 'font-size': 11}, g);
    e.textContent = o.yfmt ? o.yfmt(t) : t;
  }
  for (const t of o.xticks) {
    const e = el('text', {x: X(t), y: H - m.b + 18, 'text-anchor': 'middle', 'font-size': 11}, g);
    e.textContent = o.xfmt ? o.xfmt(t) : t;
  }
  el('line', {x1: m.l, x2: W - m.r, y1: m.t + ih, y2: m.t + ih, stroke: 'var(--ink-3)', 'stroke-width': 1}, g);
  if (o.xlabel) { const t = el('text', {x: W - m.r, y: H - 3, 'text-anchor': 'end', 'font-size': 11, class: 'lbl'}, g); t.textContent = o.xlabel; }
  if (o.ylabel) { const t = el('text', {x: m.l - 44, y: 12, 'font-size': 11, class: 'lbl'}, g); t.textContent = o.ylabel; }
  for (const r of (o.refs || [])) {
    el('line', {x1: m.l, x2: W - m.r, y1: Y(r.y), y2: Y(r.y), stroke: 'var(--ink-3)', 'stroke-width': 1, 'stroke-dasharray': '4 4'}, g);
    if (r.label) { const t = el('text', {x: W - m.r, y: Y(r.y) - 5, 'text-anchor': 'end', 'font-size': 11, class: 'lbl'}, g); t.textContent = r.label; }
  }
  for (const v of (o.vlines || [])) {
    el('line', {x1: X(v.x), x2: X(v.x), y1: m.t, y2: m.t + ih, stroke: v.color || 'var(--ink-2)', 'stroke-width': v.width || 1, 'stroke-dasharray': v.dash || ''}, g);
    if (v.label) { const t = el('text', {x: X(v.x) + 5, y: m.t + 14, 'font-size': 11, class: 'lbl'}, g); t.textContent = v.label; }
  }
  const cid = 'clip' + (++clipN);
  el('rect', {x: m.l, y: m.t - 6, width: iw, height: ih + 12}, el('clipPath', {id: cid}, el('defs', {}, svg)));
  const plot = el('g', {'clip-path': `url(#${cid})`}, svg);
  const paths = [];
  for (const s of o.series) {
    let d = '', pen = false;
    s.xs.forEach((x, i) => {
      const v = s.ys[i];
      if (v == null || (o.log && v <= 0)) { pen = false; return; }
      d += (pen ? 'L' : 'M') + X(x).toFixed(1) + ',' + Y(v).toFixed(1);
      pen = true;
    });
    const p = el('path', {d, fill: 'none', stroke: s.color, 'stroke-width': s.width || 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round', opacity: s.opacity || 1, 'stroke-dasharray': s.dash || ''}, plot);
    paths.push(p);
    if (s.marker) s.xs.forEach((x, i) => { const v = s.ys[i]; if (v != null) el('circle', {cx: X(x), cy: Y(v), r: 4.5, fill: s.ok && !s.ok[i] ? 'var(--panel)' : s.color, stroke: s.color, 'stroke-width': 2}, plot); });
  }
  const cross = el('line', {y1: m.t, y2: m.t + ih, stroke: 'var(--ink-3)', 'stroke-width': 1, visibility: 'hidden'}, svg);
  const hit = el('rect', {x: m.l, y: m.t, width: iw, height: ih, fill: 'transparent'}, svg);
  let hl = null;
  const near = (s, x) => { let bi = -1, bd = Infinity; s.xs.forEach((xx, i) => { if (s.ys[i] == null) return; const dd = Math.abs(tx(xx) - tx(x)); if (dd < bd) { bd = dd; bi = i; } }); return bi; };
  hit.addEventListener('pointermove', ev => {
    const r = svg.getBoundingClientRect();
    const px = (ev.clientX - r.left) / r.width * W, py = (ev.clientY - r.top) / r.height * H;
    const tv = x0 + (px - m.l) / iw * (x1 - x0);
    const x = o.symlog ? Math.sign(tv) * lt * (10 ** Math.abs(tv) - 1) : tv;
    if (o.nearest) {
      let best = null, bd = Infinity;
      o.series.forEach((s, j) => { const i = near(s, x); if (i < 0) return; const dd = Math.abs(Y(s.ys[i]) - py) + Math.abs(X(s.xs[i]) - px) * 0.2; if (dd < bd) { bd = dd; best = [j, i]; } });
      if (!best) return;
      const [j, i] = best, s = o.series[j];
      if (hl !== null) { paths[hl].setAttribute('stroke-width', o.series[hl].width || 2); paths[hl].setAttribute('opacity', o.series[hl].opacity || 1); }
      paths[j].setAttribute('stroke-width', 3.5); paths[j].setAttribute('opacity', 1); hl = j;
      cross.setAttribute('x1', X(s.xs[i])); cross.setAttribute('x2', X(s.xs[i])); cross.setAttribute('visibility', 'visible');
      showTip(ev, `<b>${o.xfmt ? o.xfmt(s.xs[i]) : s.xs[i]}</b><br><span style="color:${s.color}">●</span> ${sup(s.label)}: ${fmt(s.ys[i], o.digits || 3)}`);
      return;
    }
    const rows = []; let bx = null;
    for (const s of o.series) {
      if (s.noTip) continue;
      const i = near(s, x); if (i < 0) continue;
      bx = bx ?? s.xs[i];
      rows.push(`<span style="color:${s.color}">●</span> ${sup(s.label)}: ${fmt(s.ys[i], o.digits || 3)}`);
    }
    if (bx == null) return;
    cross.setAttribute('x1', X(bx)); cross.setAttribute('x2', X(bx)); cross.setAttribute('visibility', 'visible');
    showTip(ev, `<b>${o.xfmt ? o.xfmt(bx) : bx}</b><br>` + rows.join('<br>'));
  });
  hit.addEventListener('pointerleave', () => {
    cross.setAttribute('visibility', 'hidden'); hideTip();
    if (hl !== null) { paths[hl].setAttribute('stroke-width', o.series[hl].width || 2); paths[hl].setAttribute('opacity', o.series[hl].opacity || 1); hl = null; }
  });
}

function dotPlot(host, groups, cols) {
  const head = document.createElement('div'); head.className = 'row head';
  head.style.gridTemplateColumns = `minmax(8rem, 13rem) ${cols.map(() => '1fr').join(' ')} 4.5rem`;
  head.innerHTML = '<div class="name muted small">run</div>';
  for (const c of cols) {
    const ax = document.createElement('div'); ax.className = 'axis';
    let h = `<span class="t">${c.title}</span>`;
    for (const v of c.ticks) h += `<span style="left:${(v - c.min) / (c.max - c.min) * 100}%">${v}</span>`;
    ax.innerHTML = h; head.appendChild(ax);
  }
  const vh = document.createElement('div'); vh.className = 'name muted small'; vh.textContent = '判定'; head.appendChild(vh);
  host.appendChild(head);
  for (const [gname, rows] of groups) {
    const gr = document.createElement('div'); gr.className = 'row group'; gr.innerHTML = `<span>${gname}</span>`; host.appendChild(gr);
    for (const r of rows) {
      const row = document.createElement('div'); row.className = 'row';
      row.style.gridTemplateColumns = head.style.gridTemplateColumns;
      const nm = document.createElement('div'); nm.className = 'name'; nm.innerHTML = sup(r.name); row.appendChild(nm);
      if (r.fail) {
        const f = document.createElement('div'); f.className = 'fail'; f.style.gridColumn = `span ${cols.length}`; f.textContent = r.fail; row.appendChild(f);
      } else {
        cols.forEach((c, j) => {
          const tr = document.createElement('div'); tr.className = 'track';
          if (c.ref != null) { const l = document.createElement('i'); l.className = 'ref'; l.style.left = (c.ref - c.min) / (c.max - c.min) * 100 + '%'; tr.appendChild(l); }
          const v = r.vals[j];
          if (v != null) {
            const p = Math.min(Math.max((v - c.min) / (c.max - c.min), 0), 1) * 100;
            const d = document.createElement('b'); d.className = 'dot' + (r.hollow ? ' hollow' : '') + ((v > c.max || v < c.min) ? ' out' : '');
            d.style.left = p + '%'; d.style.setProperty('--c', r.color);
            d.addEventListener('pointerenter', ev => showTip(ev, `${sup(r.name)}<br>${c.title}: <b>${fmt(v, c.digits || 3)}</b>`));
            d.addEventListener('pointerleave', hideTip);
            tr.appendChild(d);
          }
          row.appendChild(tr);
        });
      }
      const vd = document.createElement('div');
      vd.innerHTML = r.ok == null ? '' : (r.ok ? '<span class="chip ok">学べた</span>' : '<span class="chip ng">×</span>');
      if (r.why) vd.title = r.why;
      row.appendChild(vd);
      host.appendChild(row);
    }
  }
}


// ---- the runs ----
const R = D.runs;
const by = (b, f) => R.filter(r => r.b === b && (!f || f(r)));
const one = (b, f) => by(b, f)[0];
const OPTN = {sgd: 'SGD', nesterov: 'Nesterov', rmsprop: 'RMSProp', rmsprop_centered: 'RMSProp（centered）', adadelta: 'Adadelta', rprop: 'Rprop', muon: 'Muon', adamw: 'AdamW', angular: 'Angular'};
const COL = {sgd: 'var(--s1)', nesterov: 'var(--s1)', adadelta: 'var(--s1)', rmsprop: 'var(--s3)', rmsprop_centered: 'var(--s3)', adamw: 'var(--s4)', angular: 'var(--s2)', rprop: 'var(--neutral)', muon: 'var(--neutral)'};
const tauS = t => {
  const k = Math.floor(Math.log10(t) + 1e-9), m = t / 10 ** k;
  if (t < 100) return String(t);
  return (Math.abs(m - 1) < 1e-6 ? '' : Math.round(m) + '·') + '10<sup>' + k + '</sup>';
};
const zd = r => r.z ? r.zd : null;
const last = r => r.span ? r.span[r.span.length - 1] : null;
const WHY = {span_down: 'span が下がらない', span_lt1: 'span が 1 以上', after_down: 'after が下がらない', recon_blur_down: 'recon_blur', dyn_down: 'dyn_1/copy_1'};
const whyS = r => r.ok ? '' : (r.why || []).map(w => WHY[w] || w).join('、');
const failOf = r => r.span ? null : `発散（${Math.round(r.diverged_at)} 秒）`;
const dotRow = (r, name, vals) => ({name, vals, color: COL[r.opt], ok: r.span ? r.ok : false, why: whyS(r), fail: failOf(r)});

// ---- the diagram ----
(() => {
  const g = document.getElementById('nodes');
  const names = ['入力', 'enc1', 'enc2', 'enc3', 'enc4', 'latent', 'dec1', 'dec2', 'out'];
  const w = 70, gap = 13, y = 52;
  names.forEach((n, i) => {
    const x = 10 + i * (w + gap);
    const dec = i >= 6, enc = i >= 1 && i <= 4;
    el('rect', {x, y, width: w, height: 40, rx: 6, fill: 'var(--panel)', stroke: dec ? 'var(--s2)' : enc ? 'var(--s1)' : 'var(--ink-3)', 'stroke-width': dec || enc ? 2 : 1}, g);
    const t = el('text', {x: x + w / 2, y: y + 25, 'text-anchor': 'middle'}, g); t.textContent = n;
    if (i < names.length - 1) el('line', {x1: x + w, x2: x + w + gap, y1: y + 20, y2: y + 20, stroke: 'var(--ink-3)', 'stroke-width': 1.5}, g);
  });
  const lab = (x0, x1, s, c) => {
    el('line', {x1: x0, x2: x1, y1: 34, y2: 34, stroke: c, 'stroke-width': 2}, g);
    const t = el('text', {x: (x0 + x1) / 2, y: 26, 'text-anchor': 'middle', class: 'lbl'}, g); t.textContent = s;
  };
  lab(10 + 1 * (w + gap), 10 + 4 * (w + gap) + w, 'エンコーダ（τ = T_enc）', 'var(--s1)');
  lab(10 + 6 * (w + gap), 10 + 8 * (w + gap) + w, 'デコーダ（τ = T_dec）', 'var(--s2)');
  const t = el('text', {x: 10 + 5 * (w + gap) + w / 2, y: 118, 'text-anchor': 'middle', class: 'lbl'}, g); t.textContent = 'z（256 次元）';
})();

// ---- V11 ----
(() => {
  const v = by('v11-zoo');
  const pick = (opt, taus) => taus.map(t => v.find(r => r.opt === opt && Math.abs(r.tau - t) < 1e-9)).filter(Boolean);
  const rows = rs => rs.map(r => dotRow(r, `${OPTN[r.opt]} τ=${tauS(r.tau)}`, [last(r), zd(r)]));
  dotPlot(document.getElementById('c-v11'), [
    ['正規化なし', rows(pick('nesterov', [1e4, 1e5, 1e6]))],
    ['重みごとに一歩をそろえる', rows([...pick('rmsprop_centered', [1e3, 1e4, 1e5]), ...pick('adadelta', [0.1, 1, 10])])],
    ['符号だけを使う', rows(pick('rprop', [1e3, 1e4, 1e5]))],
    ['行列ごとに一歩をそろえる', rows(pick('muon', [1e3, 1e4, 1e5]))],
    ['基準（V8 と同じ設定）', rows([...pick('sgd', [1e5]), ...pick('rmsprop', [1e4]), ...pick('adamw', [1e5])])],
  ], [
    {title: 'span（1800 秒）', min: 0, max: 2, ref: 1, ticks: [0, 0.5, 1, 1.5, 2]},
    {title: 'z の差', min: -0.1, max: 1, ref: 0.2, ticks: [0, 0.5, 1]},
  ]);
})();

// ---- V12 ----
(() => {
  const DS = [0.1, 1, 10, 100];
  const base = {sgd: one('v11-zoo', r => r.opt === 'sgd'), rmsprop: one('v11-zoo', r => r.opt === 'rmsprop')};
  const series = ['sgd', 'rmsprop'].map(o => {
    const rs = DS.map(d => d === 1 ? base[o] : one('v12-dec', r => r.opt === o && Math.abs(r.dec - d) < 1e-9));
    return {label: o === 'sgd' ? 'SGD τ=1e5' : 'RMSProp τ=1e4', color: COL[o], xs: DS.map(Math.log10), ys: rs.map(r => r && r.span ? last(r) : null), ok: rs.map(r => r && r.ok), marker: true};
  });
  lineChart(document.getElementById('c-v12'), {series, xmin: -1.2, xmax: 2.2, ymin: 0, ymax: 3, xticks: [-1, 0, 1, 2], yticks: [0, 0.5, 1, 1.5, 2, 2.5, 3], xfmt: x => '×' + 10 ** x, xlabel: 'デコーダの τ の倍率', ylabel: 'span', refs: [{y: 1, label: '平均の画像'}], legend: series.map(s => ({label: sup(s.label), color: s.color}))});
})();

// ---- z_use ----
(() => {
  const rs = [...by('v11-zoo'), ...by('v12-dec')].filter(r => r.z).sort((a, b) => zd(b) - zd(a));
  const name = r => `${OPTN[r.opt]} τ=${tauS(r.tau)}` + (r.dec !== 1 ? `、デコーダ ×${r.dec}` : '');
  const grp = [['使っている（差 &gt; 0.2）', rs.filter(r => zd(r) > 0.2)], ['あいだ', rs.filter(r => zd(r) <= 0.2 && zd(r) >= 0.05)], ['使っていない（差 &lt; 0.05）', rs.filter(r => zd(r) < 0.05)]];
  dotPlot(document.getElementById('c-zuse'), grp.map(([g, x]) => [g, x.map(r => dotRow(r, name(r), [r.z.span, r.z.span_shifted, zd(r)]))]), [
    {title: '正しい z', min: 0, max: 2, ref: 1, ticks: [0, 1, 2]},
    {title: '900 秒離れた z', min: 0, max: 2, ref: 1, ticks: [0, 1, 2]},
    {title: 'z の差', min: -0.1, max: 1, ref: 0.2, ticks: [0, 0.5, 1]},
  ]);
})();

// ---- V13 ----
(() => {
  const B = [['sgd', 1e5, 'SGD τ=1e5'], ['rmsprop', 1e4, 'RMSProp τ=1e4'], ['adamw', 1e5, 'AdamW τ=1e5']];
  const vals = r => [last(r), r.now, r.forget ? r.forget[0] : null];
  dotPlot(document.getElementById('c-v13'), B.map(([o, t, lab]) => {
    const no = one('v11-zoo', r => r.opt === o && r.tau === t);
    const og = by('v13-ogd', r => r.opt === o).sort((a, b) => a.ogd - b.ogd);
    return [sup(lab), [dotRow(no, 'OGD なし', vals(no)), ...og.map(r => dotRow(r, `OGD s=${r.ogd} 秒`, vals(r)))]];
  }), [
    {title: 'span（1800 秒）', min: 0, max: 5, ref: 1, ticks: [0, 1, 2, 3, 4, 5]},
    {title: '今の誤差', min: 0, max: 7, ref: 1, ticks: [0, 2, 4, 6]},
    {title: '忘却 10〜60 秒', min: -0.5, max: 1.5, ref: 0, ticks: [-0.5, 0, 0.5, 1, 1.5]},
  ]);
})();

// ---- V14 ----
(() => {
  const WS = [128, 256, 512, 1024], WC = {128: 'var(--s1)', 256: 'var(--s3)', 512: 'var(--s4)', 1024: 'var(--s2)'};
  const TS = [1e3, 3e3, 1e4, 3e4, 1e5];
  const runsOf = (p, w) => by('v14-width', r => r.w === w && (r.p === p || w === 256));
  for (const p of ['sp', 'mup']) {
    const series = WS.map(w => {
      const rs = TS.map(t => runsOf(p, w).find(r => Math.abs(r.tau - t) < 1e-6));
      return {label: '幅 ' + w, color: WC[w], xs: TS.map(Math.log10), ys: rs.map(r => r ? last(r) : null), ok: rs.map(r => r && r.ok), marker: true};
    });
    lineChart(document.getElementById('c-v14-' + p), {series, width: 420, height: 300, xmin: 2.85, xmax: 5.15, ymin: 0.5, ymax: 1.8, xticks: TS.map(Math.log10), yticks: [0.6, 0.8, 1, 1.2, 1.4, 1.6, 1.8], xfmt: x => ({3: '10³', 3.5: '3·10³', 4: '10⁴', 4.5: '3·10⁴', 5: '10⁵'})[Math.round(x * 2) / 2], xlabel: 'τ', ylabel: 'span', refs: [{y: 1}], legend: series.map(s => ({label: s.label, color: s.color}))});
  }
  const best = (p, w) => {
    const ok = runsOf(p, w).filter(r => r.ok).sort((a, b) => last(a) - last(b));
    if (!ok.length) return '—';
    const b = ok[0], near = ok.slice(1).filter(r => last(r) - last(b) < 0.07);
    return `${tauS(b.tau)}（${fmt(last(b))}）` + (near.length ? `<br><span class="small muted">${near.map(r => tauS(r.tau) + '（' + fmt(last(r)) + '）').join('、')}</span>` : '');
  };
  document.getElementById('t-v14').innerHTML = [['sp', 'SP'], ['mup', 'μP']].map(([p, lab]) => `<tr><th>${lab}</th>${WS.map(w => `<td class="num">${best(p, w)}</td>`).join('')}</tr>`).join('');
})();

// ---- V15 grid ----
(() => {
  const ENCS = [100, 300, 1000, 3000], DECS = [30, 100, 300, 1000, 3000, 10000];
  const v = by('v15-speed');
  const cell = (tEnc, tDec) => v.find(r => Math.abs(r.tau - tEnc) < 1e-6 && Math.abs(r.tau * r.dec - tDec) / tDec < 1e-3);
  let h = '<thead><tr><th>T<sub>enc</sub> ＼ T<sub>dec</sub></th>' + DECS.map(t => `<th>${t} 秒</th>`).join('') + '</tr></thead><tbody>';
  for (const tEnc of ENCS) {
    h += `<tr><th>${tEnc} 秒</th>`;
    for (const tDec of DECS) {
      const r = cell(tEnc, tDec), z = zd(r), a = Math.round(Math.max(0, Math.min(1, z)) * 55);
      const vd = r.ok ? '<span class="v" style="color:var(--good)">学べた</span>' : `<span class="v muted">× ${whyS(r)}</span>`;
      h += `<td class="${r.ok ? 'ok' : ''}" style="background:color-mix(in srgb, var(--s3) ${a}%, var(--panel))" title="${r.id}"><span class="s">${fmt(last(r))}</span><span class="z">z ${z < -5e-4 ? '−' : '+'}${fmt(Math.abs(z))}</span>${vd}</td>`;
    }
    h += '</tr>';
  }
  document.getElementById('t-v15').innerHTML = h + '</tbody>';
})();

// ---- step vs drift ----
function scatter(host, o) {
  host.innerHTML = '';
  if (o.legend) legend(host, o.legend);
  const W = 420, H = 300, m = {l: 46, r: 14, t: 16, b: 40};
  const svg = el('svg', {viewBox: `0 0 ${W} ${H}`, role: 'img', 'aria-label': o.aria || ''}); host.appendChild(svg);
  const iw = W - m.l - m.r, ih = H - m.t - m.b;
  const lx0 = Math.log10(o.xmin), lx1 = Math.log10(o.xmax);
  const X = x => m.l + (Math.log10(x) - lx0) / (lx1 - lx0) * iw;
  const Y = y => m.t + ih - (y - o.ymin) / (o.ymax - o.ymin) * ih;
  for (const t of o.yticks) { el('line', {x1: m.l, x2: W - m.r, y1: Y(t), y2: Y(t), stroke: 'var(--grid)'}, svg); const e = el('text', {x: m.l - 6, y: Y(t) + 4, 'text-anchor': 'end', 'font-size': 11}, svg); e.textContent = t; }
  for (const t of o.xticks) { el('line', {x1: X(t), x2: X(t), y1: m.t, y2: m.t + ih, stroke: 'var(--grid)'}, svg); const e = el('text', {x: X(t), y: H - m.b + 16, 'text-anchor': 'middle', 'font-size': 11}, svg); e.textContent = o.xfmt ? o.xfmt(t) : t; }
  for (const y of o.refs) el('line', {x1: m.l, x2: W - m.r, y1: Y(y), y2: Y(y), stroke: 'var(--ink-3)', 'stroke-dasharray': '4 4'}, svg);
  el('line', {x1: m.l, x2: W - m.r, y1: m.t + ih, y2: m.t + ih, stroke: 'var(--ink-3)'}, svg);
  const xl = el('text', {x: W - m.r, y: H - 4, 'text-anchor': 'end', 'font-size': 11, class: 'lbl'}, svg); xl.textContent = o.xlabel;
  const yl = el('text', {x: 4, y: 11, 'font-size': 11, class: 'lbl'}, svg); yl.textContent = o.ylabel;
  for (const p of o.points) {
    const c = el('circle', {cx: X(p.x), cy: Y(p.y), r: p.mark ? 6 : 4.5, fill: p.hollow ? 'var(--panel)' : p.color, stroke: p.color, 'stroke-width': 2}, svg);
    c.addEventListener('pointerenter', ev => showTip(ev, p.tip)); c.addEventListener('pointerleave', hideTip);
    if (p.mark) { const t = el('text', {x: X(p.x) + 8, y: Y(p.y) - 8, 'font-size': 11, class: 'lbl'}, svg); t.textContent = p.mark; }
  }
}
(() => {
  const rs = [...by('v11-zoo'), ...by('v12-dec'), ...by('v15-speed'), ...by('v15-seeds')].filter(r => r.z && r.drift);
  const name = r => r.opt === 'angular' ? `Angular ${r.tau}・${Math.round(r.tau * r.dec)} 秒` : `${OPTN[r.opt]} τ=${tauS(r.tau)}` + (r.dec !== 1 ? `、デコーダ ×${r.dec}` : '') + (r.seed ? ` seed ${r.seed}` : '');
  const mark = r => r.id === '64ae5ffa-s0' ? 'RMSProp 10⁴' : r.id === '5a45baf7-s0' ? 'Angular 300・300' : null;
  const tipOf = (r, x) => `${name(r)}<br>${x}<br>z の差: <b>${fmt(zd(r))}</b>、span ${fmt(last(r))}`;
  const fams = [['sgd', 'SGD 系'], ['rmsprop', 'RMSProp 系'], ['adamw', 'AdamW'], ['angular', 'Angular'], ['muon', 'Muon・Rprop']];
  const lg = fams.map(([f, l]) => ({label: l, color: COL[f]}));
  const common = {ymin: -0.1, ymax: 1, yticks: [0, 0.2, 0.4, 0.6, 0.8, 1], refs: [0.2, 0.05], ylabel: 'z の差', legend: lg};
  scatter(document.getElementById('c-step'), {...common, xmin: 10, xmax: 1e5, xticks: [10, 100, 1e3, 1e4, 1e5], xfmt: t => t >= 1e3 ? (t / 1e3) + 'k' : t, xlabel: 'dec2 が 1 ラジアン回る秒数', points: rs.filter(r => r.step_dec2).map(r => ({x: r.step_dec2, y: zd(r), color: COL[r.opt], mark: mark(r), tip: tipOf(r, `1 ラジアンに ${Math.round(r.step_dec2)} 秒`)}))});
  scatter(document.getElementById('c-drift'), {...common, xmin: 0.05, xmax: 60, xticks: [0.1, 1, 10], xfmt: t => t + '%', xlabel: 'デコーダの 60 秒の変位', points: rs.map(r => ({x: r.drift.dec * 100, y: zd(r), color: COL[r.opt], mark: mark(r), tip: tipOf(r, `60 秒の変位: デコーダ ${fmt(r.drift.dec * 100, 2)}%、エンコーダ ${fmt(r.drift.enc * 100, 2)}%`)}))});
})();

// ---- seeds ----
(() => {
  const grp = [
    ['RMSProp τ=1e4（V8）', [...by('v8-adapt'), ...by('v8-rms')]],
    ['SGD τ=1e5、デコーダ ×100', [...by('v12-dec', r => r.opt === 'sgd' && r.dec === 100), ...by('v15-seeds', r => r.opt === 'sgd')]],
    ['Muon τ=1e4', [...by('v11-zoo', r => r.opt === 'muon' && r.tau === 1e4), ...by('v15-seeds', r => r.opt === 'muon')]],
  ];
  dotPlot(document.getElementById('c-seeds'), grp.map(([g, rs]) => [sup(g), rs.sort((a, b) => a.seed - b.seed).map(r => dotRow(r, 'seed ' + r.seed, [last(r), r.dyn]))]), [
    {title: 'span（1800 秒）', min: 0.5, max: 1, ticks: [0.5, 0.6, 0.7, 0.8, 0.9, 1]},
    {title: 'dyn_1/copy_1', min: 0.3, max: 1.1, ref: 0.99, ticks: [0.4, 0.6, 0.8, 1]},
  ]);
})();

// ---- images ----
function setRecon(box, key) {
  box.dataset.img = key;
  let img = box.querySelector('img');
  if (!img) {
    const labs = document.createElement('div'); labs.className = 'rows';
    for (const t of box.dataset.rows.split('|')) { const s = document.createElement('span'); s.textContent = t; labs.appendChild(s); }
    box.appendChild(labs);
    img = document.createElement('img'); box.appendChild(img);
  }
  img.src = D.img[key]; img.alt = box.dataset.rows.replace(/\|/g, '、') + 'の 3 段';
}
for (const [seg, box] of [['seg-v12', 'r-v12'], ['seg-drift', 'r-drift']]) {
  const b = document.getElementById(box); setRecon(b, b.dataset.img);
  document.querySelectorAll(`#${seg} button`).forEach(x => x.addEventListener('click', () => {
    document.querySelectorAll(`#${seg} button`).forEach(y => y.setAttribute('aria-pressed', y === x ? 'true' : 'false'));
    setRecon(b, x.dataset.key);
  }));
}
})();
</script>
</html>
