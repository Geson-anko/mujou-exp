  for (const id of D.p16_long) {
    const r = L18.find(q => q.id === id);
    const pool = r.h_flat, img = r.img_h_mean;
    runs.push({id, arm: 'p16', seed: r.seed, step: r.step, recon: r.recon, calib: r.calib, pool: r.step.map(s => (pool.find(p => p[0] === s) || [])[1] ?? null), img: r.step.map(s => (img.find(p => p[0] === s) || [])[1] ?? null)});
  }
  const lab = r => `${ARM[r.arm][0]}・seed ${r.seed}`;
  const seriesOf = (key, from, marker) => runs.map(r => ({label: lab(r), color: ARM[r.arm][1], dash: r.seed ? '6 3' : '', width: 2.2, marker, ...pairs(r.step, r[key], from)}));
  const lg = [...Object.values(ARM).map(([l, c]) => ({label: l, color: c})), {label: 'seed 1', color: 'var(--ink-3)', dash: '6 3'}];
