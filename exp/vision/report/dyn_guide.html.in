<title>予測しやすさの評価</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap">
<style>
/* Layout: one reading column of about 46rem; figures widen to 60rem. */
:root {
  --bg: #f3f5f8;
  --panel: #ffffff;
  --ink: #13171e;
  --ink-2: #4b5462;
  --ink-3: #6f7886;
  --rule: #d7dce4;
  --grid: #e6e9ee;
  --accent: #2a78d6;
  --s1: #2a78d6;
  --s2: #eb6834;
  --s3: #1baf7a;
  --s4: #eda100;
  --neutral: #9aa3af;
  --good: #0a7d0a;
  --bad: #c03434;
  --warn: #9a6400;
  --good-bg: #e3f3e3;
  --bad-bg: #fbe5e5;
  --warn-bg: #fbf0d9;
  --why-bg: #e8f0fb;
  --font-display: "Zen Kaku Gothic New", "Hiragino Sans", "Noto Sans JP", sans-serif;
  --font-body: "Zen Kaku Gothic New", "Hiragino Sans", "Noto Sans JP", "Yu Gothic", sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #111418; --panel: #181c22; --ink: #e8ebef; --ink-2: #b3bac5; --ink-3: #8b94a1;
    --rule: #2b313a; --grid: #232830; --accent: #5b9df0;
    --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --neutral: #6c7582;
    --good: #4cc24c; --bad: #ec6b6b; --warn: #e0a23a;
    --good-bg: #16301a; --bad-bg: #3a1c1c; --warn-bg: #3a2c12; --why-bg: #172436;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #111418; --panel: #181c22; --ink: #e8ebef; --ink-2: #b3bac5; --ink-3: #8b94a1;
  --rule: #2b313a; --grid: #232830; --accent: #5b9df0;
  --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --neutral: #6c7582;
  --good: #4cc24c; --bad: #ec6b6b; --warn: #e0a23a;
  --good-bg: #16301a; --bad-bg: #3a1c1c; --warn-bg: #3a2c12; --why-bg: #172436;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--bg); color: var(--ink);
  font-family: var(--font-body); font-size: 16px; line-height: 1.9;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 0 72px;
  -webkit-font-smoothing: antialiased;
  overflow-wrap: anywhere;
}
main { max-width: 60rem; margin: 0 auto; display: flex; flex-direction: column; gap: 64px; }
h1, h2, h3 { font-family: var(--font-display); text-wrap: balance; line-height: 1.4; margin: 0; }
h1 { font-weight: 900; font-size: clamp(1.8rem, 5vw, 2.6rem); letter-spacing: 0.01em; }
h2 { font-weight: 900; font-size: 1.5rem; }
h3 { font-weight: 700; font-size: 1.1rem; }
p { margin: 0; }
code, .mono { font-family: var(--font-mono); font-size: 0.88em; }
code { background: var(--grid); padding: 0.05em 0.35em; border-radius: 3px; overflow-wrap: anywhere; }
var { font-style: italic; font-family: "Times New Roman", serif; font-size: 1.05em; }
.num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
section { display: flex; flex-direction: column; gap: 20px; }
.eyebrow { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.08em; color: var(--ink-3); }
.sec-head { display: flex; flex-direction: column; gap: 6px; border-top: 2px solid var(--ink); padding-top: 14px; max-width: 46rem; }
.prose { display: flex; flex-direction: column; gap: 14px; max-width: 46rem; }
.prose ul, .prose ol { margin: 0; padding-left: 1.3em; display: flex; flex-direction: column; gap: 6px; }
.muted { color: var(--ink-2); }
.small { font-size: 0.88rem; }
.ob { text-decoration: overline; }

header.hero { padding-top: 48px; display: flex; flex-direction: column; gap: 18px; max-width: 46rem; }
.hero .lead { font-size: 1.08rem; color: var(--ink-2); }
.meta { display: flex; flex-wrap: wrap; gap: 4px 20px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-3); }
nav.toc { max-width: 46rem; background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; padding: 14px 18px; }
nav.toc ol { margin: 6px 0 0; padding-left: 1.4em; font-size: 0.92rem; columns: 2 16rem; column-gap: 2rem; }
nav.toc a { color: var(--accent); text-decoration: none; }
nav.toc a:hover, nav.toc a:focus-visible { text-decoration: underline; }

.why { max-width: 46rem; background: var(--why-bg); border-left: 4px solid var(--accent); border-radius: 0 6px 6px 0; padding: 12px 16px; display: flex; flex-direction: column; gap: 6px; }
.why .k { font-weight: 700; font-size: 0.86rem; color: var(--accent); }
.status { max-width: 46rem; background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; }
.status ul { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: 4px; }

/* the flow of this guide */
.flow { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; max-width: 46rem; counter-reset: step; }
.flow li { position: relative; padding: 10px 0 10px 52px; border-left: 2px solid var(--rule); margin-left: 17px; }
.flow li::before { counter-increment: step; content: counter(step); position: absolute; left: -18px; top: 10px; width: 34px; height: 34px; border-radius: 50%; background: var(--panel); border: 2px solid var(--accent); color: var(--accent); font-family: var(--font-mono); font-weight: 500; display: flex; align-items: center; justify-content: center; }
.flow li b { display: block; }
.flow .grp { margin: 14px 0 4px 0; font-size: 0.8rem; color: var(--ink-3); font-family: var(--font-mono); letter-spacing: 0.06em; padding-left: 0; border: 0; }
.flow .grp::before { content: none; }

.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 14px; }
.card { background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.card .k { font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-3); letter-spacing: 0.06em; }
.card h3 { font-size: 1rem; }
.card p { font-size: 0.92rem; }

figure { margin: 0; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
figcaption { font-size: 0.86rem; color: var(--ink-2); line-height: 1.75; max-width: 46rem; }
.tag { display: inline-block; font-size: 0.74rem; font-weight: 700; border-radius: 3px; padding: 0 6px; margin-right: 6px; vertical-align: 1px; }
.tag.schema { background: var(--warn-bg); color: var(--warn); }
.tag.data { background: var(--good-bg); color: var(--good); }
.chart { width: 100%; max-width: 46rem; background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; padding: 10px; }
.chart svg { display: block; width: 100%; height: auto; }

/* diagrams */
.dg text { font-family: var(--font-body); fill: var(--ink-2); font-size: 15px; }
.dg text.strong { fill: var(--ink); font-weight: 700; }
.dg text.small { font-size: 13px; }
.dg text.mono { font-family: var(--font-mono); }
.dg text.big { font-size: 22px; font-weight: 900; fill: var(--ink); }
.dg text.accent { fill: var(--accent); }
.dg text.warn { fill: var(--warn); }
.dg text.onbar { fill: #ffffff; }
.dg .box { fill: var(--bg); stroke: var(--ink-3); stroke-width: 1.2; }
.dg .ln { stroke: var(--ink-3); stroke-width: 1.5; fill: none; }
.dg .axis { stroke: var(--ink-3); stroke-width: 1.2; }
.dg .gridline { stroke: var(--grid); stroke-width: 1; }
.dg .chance { stroke: var(--ink-3); stroke-width: 1.2; stroke-dasharray: 4 4; }
.dg .tick { stroke-width: 2; }
.dg .ray { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 2 3; }
.dg .cross { stroke: var(--ink); stroke-width: 2.5; }
.dg .cell { stroke: var(--panel); stroke-width: 1; }
.dg .c1 { fill: var(--s1); } .dg .c2 { fill: var(--s2); } .dg .c3 { fill: var(--s3); } .dg .c4 { fill: var(--s4); } .dg .cn { fill: var(--neutral); }
.dg .c2s { stroke: var(--s2); } .dg .c4s { stroke: var(--s4); }
.dg .hatch { fill: url(#hatch); }
.dg .qline { fill: none; stroke: var(--ink); stroke-width: 2.5; }
.dg .shade { fill: var(--grid); }
.dg .refline { stroke: var(--ink-2); stroke-width: 1.5; }
.dg .refline.bad { stroke: var(--bad); stroke-dasharray: 5 4; }
.dg .cloud { fill: var(--why-bg); stroke: var(--ink-3); stroke-width: 1; }
.dg .ring { fill: none; stroke: var(--s2); stroke-width: 1.5; }
.dg .whisk { stroke-width: 3; }
.dg .c1s { stroke: var(--s1); } .dg .c3s { stroke: var(--s3); } .dg .cns { stroke: var(--neutral); }
.dg text.lab-bad { fill: var(--bad); }
.defs .hl { stroke: var(--ink-2); stroke-width: 2; }
.defs .hbg { fill: var(--panel); }
.defs .ah { fill: var(--ink-3); }

.eq { font-family: var(--font-mono); font-size: 0.9rem; background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; padding: 10px 14px; overflow-x: auto; max-width: 46rem; line-height: 1.8; }
.tbl { width: 100%; max-width: 46rem; overflow-x: auto; background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; }
table { border-collapse: collapse; width: 100%; font-size: 0.88rem; line-height: 1.65; }
th, td { text-align: left; vertical-align: top; padding: 8px 12px; border-bottom: 1px solid var(--rule); }
th { font-weight: 700; background: var(--grid); }
tr:last-child td { border-bottom: 0; }
td.n { font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
.badge { display: inline-block; font-size: 0.76rem; font-weight: 700; border-radius: 3px; padding: 0 6px; white-space: nowrap; }
.badge.ok { background: var(--good-bg); color: var(--good); }
.badge.ng { background: var(--bad-bg); color: var(--bad); }
.badge.wait { background: var(--warn-bg); color: var(--warn); }
blockquote { margin: 0; max-width: 46rem; border-left: 4px solid var(--rule); padding: 6px 16px; color: var(--ink-2); }
dl.gloss { max-width: 46rem; margin: 0; display: grid; grid-template-columns: minmax(7rem, 11rem) 1fr; gap: 8px 18px; font-size: 0.92rem; }
dl.gloss dt { font-weight: 700; }
dl.gloss dd { margin: 0; color: var(--ink-2); }
@media (max-width: 560px) {
  dl.gloss { grid-template-columns: 1fr; gap: 2px; }
  dl.gloss dd { margin-bottom: 10px; }
  th, td { padding: 6px 8px; }
}
/* dyn-guide additions */
.tbl table { min-width: 34rem; }
.ctrl { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; font-size: 0.86rem; max-width: 46rem; }
.ctrl label { display: flex; align-items: center; gap: 6px; }
.ctrl input[type=range] { width: 9rem; }
.ctrl select { font: inherit; font-size: 0.84rem; background: var(--panel); color: var(--ink); border: 1px solid var(--rule); border-radius: 4px; padding: 2px 4px; max-width: 15rem; }
.seg { display: inline-flex; border: 1px solid var(--rule); border-radius: 4px; overflow: hidden; }
.seg button { font: inherit; font-size: 0.82rem; background: var(--panel); color: var(--ink-2); border: 0; padding: 2px 10px; cursor: pointer; }
.seg button + button { border-left: 1px solid var(--rule); }
.seg button[aria-pressed="true"] { background: var(--accent); color: #fff; }
.readout { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-2); max-width: 46rem; line-height: 1.7; }
.legend { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 0.8rem; color: var(--ink-2); max-width: 46rem; }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend i { display: inline-block; width: 14px; height: 3px; border-radius: 2px; }
.legend i.dot { width: 9px; height: 9px; border-radius: 50%; }
.legend i.dash { background: none !important; border-top: 2px dashed; height: 0; }
.legend i.hollow { background: none !important; border: 1.5px solid; width: 9px; height: 9px; border-radius: 50%; }
.tip { position: fixed; display: none; z-index: 10; pointer-events: none; background: var(--panel); border: 1px solid var(--rule); border-radius: 4px; padding: 6px 9px; font-size: 0.78rem; line-height: 1.55; color: var(--ink); box-shadow: 0 2px 8px rgba(0,0,0,0.15); max-width: 20rem; }
.tip .mono { font-family: var(--font-mono); }
.ch text { font-family: var(--font-body); font-size: 12px; fill: var(--ink-2); }
.ch text.mono { font-family: var(--font-mono); font-size: 11px; }
.ch text.ttl { fill: var(--ink); font-weight: 700; font-size: 13px; }
.ch .grid { stroke: var(--grid); stroke-width: 1; }
.ch .axis { stroke: var(--ink-3); stroke-width: 1; }
.ch .zero { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 3 3; }
.ch .band { fill: var(--grid); opacity: 0.7; }
.chips { display: inline-flex; gap: 4px; }
.w-a { color: var(--good); } .w-b { color: var(--bad); } .w-s { color: var(--warn); } .w-n { color: var(--ink-3); }
.big-n { font-family: var(--font-mono); font-size: 1.6rem; font-weight: 500; color: var(--ink); line-height: 1.2; }
</style>

<svg class="defs" width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path class="ah" d="M0 0 L10 5 L0 10 z"/>
    </marker>
