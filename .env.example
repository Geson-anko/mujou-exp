# Copy to .env and fill in. .env is not committed.

# Host directory of the EgoDex dataset. The dev container mounts it read-only
# at /datasets/egodex. Rebuild the container after changing it.
EGODEX_DIR=/path/to/egodex

# Host directory of the Walking Tours videos (downloaded from YouTube). The dev
# container mounts it writable at /datasets/walking_tours, to download into it.
# Rebuild the container after changing it.
WALKING_TOURS_DIR=/path/to/walking_tours

# Shared directory of the fleet (queue, finished runs), on a disk every host
# mounts at the same path. The container mounts it at that path. Rebuild the
# container after changing it.
FLEET_NAS=/path/to/nas/mujou-exp
