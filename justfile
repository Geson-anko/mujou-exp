set dotenv-load := true

# Default recipe (shows help)
default:
    @just --list

# Setup the development environment (fetches the mujou submodule and builds it)
setup:
    git submodule update --init --recursive
    uv venv --clear
    uv sync
    uv run pre-commit install

# Run pre-commit hooks (ruff fix + format, mdformat, codespell, ...)
format:
    uv run pre-commit run -a

# Run pytest of this project (mujou's own tests run in mujou/: `just -f mujou/justfile test`)
test:
    uv run pytest -v

# Run pytest without slow training checks
test-fast:
    uv run pytest -v -m "not slow"

# Run pyright over experiments/ and tests/
type:
    uv run pyright

# Run all checks (format, test, type). Run it before committing.
run: format test type

# Clean autogenerated files
clean:
    rm -rf dist build htmlcov .coverage
    find . -path ./mujou -prune -o -type d -name "__pycache__" -prune -exec rm -r {} +
    find . -path ./mujou -prune -o -type d -name ".pytest_cache" -prune -exec rm -r {} +

# Show the state of the mujou submodule: its commit, branch and whether the commit is on origin
mujou-status:
    #!/usr/bin/env bash
    set -euo pipefail
    git submodule status mujou
    git -C mujou status --short --branch
    if [ -n "$(git -C mujou branch -r --contains HEAD 2>/dev/null)" ]; then
        echo "OK: the checked-out commit is on a remote branch of mujou"
    else
        echo "WARNING: the checked-out commit of mujou is NOT pushed; do not commit the submodule pointer yet" >&2
        exit 1
    fi

# Move the mujou submodule to the latest origin/main (then commit the new pointer in this repo)
mujou-update:
    git -C mujou fetch origin
    git -C mujou checkout origin/main
    uv sync

# Run a command in the dev container, in this checkout (the main one or a worktree)
[positional-arguments]
container *args:
    #!/usr/bin/env bash
    set -euo pipefail
    main="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
    devcontainer up --workspace-folder "$main" > /dev/null
    devcontainer exec --workspace-folder "$main" bash -lc 'cd "$1" && shift && exec "$@"' _ "{{justfile_directory()}}" "$@"
